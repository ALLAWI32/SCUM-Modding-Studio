<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio: right-click ScumStudio.App > Publish > "win-x64-single".
  Command line:  dotnet publish src/ScumStudio.App -p:PublishProfile=win-x64-single
  Produces one self-contained, compressed ScumStudio.App.exe (no .NET install needed on the target machine) in
  artifacts/publish/ScumStudio.App/win-x64-single/ (or <ArtifactsPath>/publish/... when ArtifactsPath is overridden).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <!-- Symbols are embedded in the exe; no loose .pdb / .xml files next to it. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(ArtifactsPath)\publish\ScumStudio.App\win-x64-single\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
