<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ScumStudio.App.ViewModels"
        xmlns:c="using:ScumStudio.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="860"
        x:Class="ScumStudio.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1440" Height="860" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding ToggleLogCommand}" />
  </Window.KeyBindings>

  <Window.DataTemplates>
    <!-- Connection segment of the status bar: dot, label, value (mono); the details are in the tooltip. -->
    <DataTemplate DataType="vm:StatusPillViewModel">
      <Border Classes="statusSegment" ToolTip.Tip="{Binding Detail}" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Ellipse Classes="dot" Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}"
                   Classes.error="{Binding IsError}" Classes.busy="{Binding IsBusy}" />
          <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMutedBrush}" />
          <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <!--
    Shell (the OS keeps its own title bar):
      40 px strip   wordmark | workspace tabs (NavList) | command field (Ctrl K) | project | setup
      page          PageHost
      console       LogPanel (Ctrl+L), mono lines
      24 px bar     status | notification tray (ToastHost) / last log line | PAKS SERVER KEY AI | counters | console | version
    Notifications live in the status bar so they never cover a working panel.
  -->
  <Panel>
    <Grid RowDefinitions="40,*,Auto,24">

      <!-- ===================================================================== Title strip -->
      <Border Grid.Row="0" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

          <!-- Wordmark: blaze tick, stencil SCUM, tracked STUDIO. -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,16,0" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding Title}">
            <Border Width="3" Height="17" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
            <TextBlock Text="SCUM" FontFamily="{DynamicResource StencilFontFamily}" FontSize="19"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="MODDING STUDIO" FontFamily="{DynamicResource CondensedFontFamily}" FontWeight="Medium" FontSize="10.5"
                       LetterSpacing="2.8" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,3,0,0" />
          </StackPanel>

          <!-- Workspace tabs. -->
          <ListBox Grid.Column="1" x:Name="NavList" Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItemViewModel">
                <Panel ToolTip.Tip="{Binding Tip}">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <c:GlyphIcon Kind="{Binding IconKey}" IconSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="Medium" FontSize="12.5"
                               IsVisible="{Binding !$parent[ListBox].((vm:MainWindowViewModel)DataContext).IsCompactHeader}" />
                    <Border Classes="badge" IsVisible="{Binding HasBadge}">
                      <TextBlock Text="{Binding Badge}" />
                    </Border>
                  </StackPanel>
                  <Border Classes="navIndicator" Height="2" VerticalAlignment="Bottom" Margin="-12,0" />
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Command field: Ctrl+K focuses it. -->
          <Panel Grid.Column="2" MaxWidth="440" MinWidth="90" Margin="14,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <TextBox x:Name="GlobalSearch" Classes="search" Text="{Binding SearchText}" Watermark="{Binding SearchWatermark}"
                     Padding="30,4,52,4" ToolTip.Tip="{Tr Shell.Search.Tip}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SubmitSearchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <c:GlyphIcon Kind="Icon.Search" IconSize="14" Margin="10,0,0,0" IsHitTestVisible="False"
                         HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
            <Border Classes="kbd" HorizontalAlignment="Right" Margin="0,0,7,0" IsHitTestVisible="False">
              <TextBlock Text="Ctrl K" />
            </Border>
          </Panel>

          <!-- Support (PayPal, e-mail, report a problem), updates (always there: "Up to date", or lit up when a newer release is out) and the project. -->
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,6,0">
            <Button x:Name="DiscordButton" Classes="ghost" Padding="8,3" Command="{Binding OpenDiscordCommand}" ToolTip.Tip="{Tr Discord.Button.Tip}">
              <c:GlyphIcon Kind="Icon.Discord" IconSize="15" Foreground="{DynamicResource DiscordBrush}" />
            </Button>
            <Button x:Name="SupportButton" Classes="ghost" Padding="10,3" Command="{Binding OpenSupportCommand}" ToolTip.Tip="{Tr Support.Button.Tip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:GlyphIcon Kind="Icon.Heart" IconSize="13" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Tr Support.Button}" FontSize="12" />
              </StackPanel>
            </Button>
            <Button x:Name="UpdateButton" Classes.accent="{Binding HasUpdate}" Classes.ghost="{Binding !HasUpdate}" Padding="10,3" Margin="0,0,10,0"
                    IsVisible="{Binding CanCheckUpdates}" Command="{Binding OpenUpdateCommand}" ToolTip.Tip="{Binding UpdateButtonTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:GlyphIcon Kind="Icon.Download" IconSize="13" />
                <TextBlock Text="{Binding UpdateButtonText}" FontSize="12" />
              </StackPanel>
            </Button>
            <Button x:Name="ProjectButton" Classes="ghost" Padding="8,3" Command="{Binding ShowProjectsCommand}" ToolTip.Tip="{Tr Shell.Project.Tip}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Tr Shell.Project}" Classes="colHeader" VerticalAlignment="Center" Margin="0,1,0,0" IsVisible="{Binding !IsCompactHeader}" />
                <TextBlock x:Name="ProjectName" Text="{Binding Projects.DisplayName}" FontWeight="SemiBold" FontSize="12.5" MaxWidth="150" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button Grid.Column="4" Classes="ghost square" Margin="0,0,8,0" Command="{Binding OpenSetupCommand}"
                  ToolTip.Tip="{Tr Shell.Setup.Tip}">
            <c:GlyphIcon Kind="Icon.Plug" IconSize="15" />
          </Button>
        </Grid>
      </Border>

      <!-- ===================================================================== Page -->
      <c:PageDeck x:Name="PageHost" Grid.Row="1" Current="{Binding CurrentPage}" />

      <!-- ===================================================================== Console -->
      <Border x:Name="LogPanel" Grid.Row="2" Height="220" IsVisible="{Binding IsLogOpen}"
              Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panelHeader" Padding="10,0,4,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
              <c:GlyphIcon Grid.Column="0" Kind="Icon.Terminal" IconSize="13" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Tr Shell.ConsoleTitle}" Classes="panelTitle" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0,0,0">
                <Border Classes="badge warn" ToolTip.Tip="{Tr Shell.Warnings}">
                  <TextBlock Text="{Binding Log.WarningCount, StringFormat='{}{0} warn'}" />
                </Border>
                <Border Classes="badge error" ToolTip.Tip="{Tr Shell.Errors}">
                  <TextBlock Text="{Binding Log.ErrorCount, StringFormat='{}{0} err'}" />
                </Border>
              </StackPanel>
              <Button Grid.Column="3" Classes="ghost small" Content="{Tr Common.Copy}" Click="OnCopyLogClick" ToolTip.Tip="{Tr Shell.CopyConsole.Tip}" />
              <Button Grid.Column="4" Classes="ghost small" Content="{Tr Common.Clear}" Command="{Binding Log.ClearCommand}" ToolTip.Tip="{Tr Shell.ClearConsole.Tip}" />
              <Button Grid.Column="5" Classes="ghost square" Width="24" Height="24" Command="{Binding ToggleLogCommand}"
                      ToolTip.Tip="{Tr Shell.HideConsole.Tip}">
                <c:GlyphIcon Kind="Icon.Close" IconSize="11" />
              </Button>
            </Grid>
          </Border>
          <!-- Click, Shift+click and Ctrl+click pick lines, Ctrl+A all of them; Ctrl+C copies them (or every line when none is picked). -->
          <ListBox x:Name="LogList" Classes="log plain" ItemsSource="{Binding Log.Entries}" Background="Transparent" SelectionMode="Multiple"
                   KeyDown="OnLogKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LogLineViewModel">
                <Grid ColumnDefinitions="64,34,170,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Classes="mono" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Time}" />
                  <TextBlock Grid.Column="1" Classes="mono logLevel" FontSize="11.5" FontWeight="Medium" Text="{Binding Level}"
                             Classes.warn="{Binding IsWarning}" Classes.error="{Binding IsError}" />
                  <TextBlock Grid.Column="2" Classes="mono" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Category}" />
                  <TextBlock Grid.Column="3" Classes="mono" FontSize="11.5" Text="{Binding Message}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ===================================================================== Status bar -->
      <Border Grid.Row="3" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">

          <!-- Operation. -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" Margin="10,0" VerticalAlignment="Center">
            <Ellipse Classes="dot" Classes.busy="{Binding Operations.IsBusy}" Classes.ok="{Binding !Operations.IsBusy}" />
            <TextBlock x:Name="StatusText" Text="{Binding Operations.StatusText}" Classes="status" MaxWidth="340" />
          </StackPanel>
          <ProgressBar Grid.Column="1" Width="120" VerticalAlignment="Center" Margin="0,0,10,0"
                       IsVisible="{Binding Operations.IsBusy}" IsIndeterminate="{Binding Operations.IsIndeterminate}"
                       Value="{Binding Operations.Progress}" Minimum="0" Maximum="100" />

          <!-- Notification tray, then the last log line in the space that is left. -->
          <DockPanel Grid.Column="2" ClipToBounds="True">
            <ItemsControl x:Name="ToastHost" DockPanel.Dock="Left" ItemsSource="{Binding Toasts}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToastViewModel">
                  <Border Classes="toast" Classes.success="{Binding IsSuccess}" Classes.warning="{Binding IsWarning}"
                          Classes.error="{Binding IsError}">
                    <ToolTip.Tip>
                      <StackPanel Spacing="2" MaxWidth="360">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Classes="wrap" />
                        <TextBlock Text="{Binding Message}" Classes="muted wrap" IsVisible="{Binding HasMessage}" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7">
                      <c:GlyphIcon Grid.Column="0" Classes="toastIcon" Kind="{Binding IconKey}" IconSize="12" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="toastTitle" Text="{Binding Title}" MaxWidth="260" />
                      <TextBlock Grid.Column="2" Classes="toastDetail" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
                      <Button Grid.Column="3" Command="{Binding CloseCommand}" ToolTip.Tip="{Tr Shell.Dismiss.Tip}" VerticalAlignment="Center">
                        <c:GlyphIcon Kind="Icon.Close" IconSize="9" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Log.Last.Message, FallbackValue=''}" Classes="status" Foreground="{DynamicResource TextMutedBrush}"
                       Margin="10,0" ToolTip.Tip="{Binding Log.Last.Message, FallbackValue=''}" IsVisible="{Binding !HasToasts}" />
          </DockPanel>

          <!-- Connections. -->
          <ContentControl Grid.Column="3" Content="{Binding GamePill}" />
          <ContentControl Grid.Column="4" Content="{Binding ServerPill}" />
          <ContentControl Grid.Column="5" Content="{Binding KeyPill}" />
          <StackPanel Grid.Column="6" Orientation="Horizontal">
            <ContentControl x:Name="AiPill" Content="{Binding AiPill}" />
            <Border Classes="statusSegment" Padding="0">
              <Button Classes="bar" Command="{Binding ConnectCommand}" ToolTip.Tip="{Tr Shell.Reconnect.Tip}">
                <c:GlyphIcon Kind="Icon.Refresh" IconSize="12" />
              </Button>
            </Border>
          </StackPanel>

          <!-- Counters, console, version. -->
          <StackPanel Grid.Column="7" Orientation="Horizontal">
            <Border Classes="statusSegment" ToolTip.Tip="{Tr Shell.Counters.Tip}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <c:GlyphIcon Kind="Icon.Warning" IconSize="12" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Log.WarningCount}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <c:GlyphIcon Kind="Icon.Error" IconSize="12" Foreground="{DynamicResource DangerBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Log.ErrorCount}" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Classes="statusSegment" Padding="0">
              <ToggleButton x:Name="LogToggle" Classes="bar" IsChecked="{Binding IsLogOpen}" ToolTip.Tip="{Tr Shell.ToggleConsole.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:GlyphIcon Kind="Icon.Terminal" IconSize="12" VerticalAlignment="Center" />
                  <TextBlock Text="{Tr Shell.Console}" Classes="status" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </ToggleButton>
            </Border>
            <Border Classes="statusSegment">
              <TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextMutedBrush}" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================================================================== Setup overlay -->
    <Panel x:Name="SetupOverlay" IsVisible="{Binding IsSetupOpen}" ZIndex="20">
      <Border Background="{DynamicResource ScrimBrush}" />
      <ContentControl Content="{Binding Setup}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
    </Panel>

    <!-- ===================================================================== Update card -->
    <Panel x:Name="UpdateOverlay" IsVisible="{Binding IsUpdateOpen}" ZIndex="21">
      <Border Background="{DynamicResource ScrimBrush}" />
      <Border Classes="dialog" Width="620" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="24,20,24,16" BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile" Width="44" Height="44" CornerRadius="{DynamicResource SmallCornerRadius}">
                <c:GlyphIcon Kind="Icon.Download" IconSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding UpdateTitle}" Classes="h1" FontSize="19" />
                <TextBlock Text="{Binding UpdateSubtitle}" Classes="muted wrap" FontSize="12.5" />
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost square" Command="{Binding CloseUpdateCommand}" VerticalAlignment="Top" ToolTip.Tip="{Tr Update.Later.Tip}">
                <c:GlyphIcon Kind="Icon.Close" IconSize="14" />
              </Button>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="24,14" BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg1Brush}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
              <ProgressBar Grid.ColumnSpan="4" Value="{Binding UpdateProgress}" Maximum="100" IsVisible="{Binding IsUpdating}" Margin="0,0,0,10" />
              <TextBlock Grid.Row="1" Text="{Binding UpdateStatus}" Classes="caption wrap" VerticalAlignment="Center" />
              <Button Grid.Row="1" Grid.Column="1" Content="{Tr Update.ReleasePage}" Classes="ghost" Command="{Binding OpenReleasePageCommand}" ToolTip.Tip="{Tr Update.ReleasePage.Tip}" />
              <Button Grid.Row="1" Grid.Column="2" Content="{Tr Update.Later}" Classes="ghost" Command="{Binding CloseUpdateCommand}" IsEnabled="{Binding !IsUpdating}" ToolTip.Tip="{Tr Update.Later.Tip}" />
              <Button Grid.Row="1" Grid.Column="3" x:Name="InstallUpdateButton" Classes="accent" Command="{Binding InstallUpdateCommand}" ToolTip.Tip="{Tr Update.Install.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:GlyphIcon Kind="Icon.Download" IconSize="14" />
                  <TextBlock Text="{Tr Update.Install}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding UpdateNotes}" Margin="24,10,24,18">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NoteLine">
                  <Panel>
                    <TextBlock Text="{Binding Text}" IsVisible="{Binding IsHeading}" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,4" TextWrapping="Wrap" />
                    <Grid IsVisible="{Binding IsBullet}" ColumnDefinitions="16,*" Margin="0,3">
                      <Border Width="5" Height="5" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,7,0,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding Text}" IsVisible="{Binding IsText}" Classes="muted" TextWrapping="Wrap" Margin="0,3" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>

    <!-- ===================================================================== Support card: support the developer, report a problem -->
    <Panel x:Name="SupportOverlay" IsVisible="{Binding IsSupportOpen}" ZIndex="21">
      <Border Background="{DynamicResource ScrimBrush}" />
      <Border Classes="dialog" Width="620" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="24,20,24,16" BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile" Width="44" Height="44" CornerRadius="{DynamicResource SmallCornerRadius}">
                <c:GlyphIcon Kind="Icon.Heart" IconSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Tr Support.Title}" Classes="h1" FontSize="19" />
                <TextBlock Text="{Tr Support.Subtitle}" Classes="muted wrap" FontSize="12.5" />
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost square" Command="{Binding CloseSupportCommand}" VerticalAlignment="Top" ToolTip.Tip="{Tr Support.Close.Tip}">
                <c:GlyphIcon Kind="Icon.Close" IconSize="14" />
              </Button>
            </Grid>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,20" Spacing="18">
              <!-- The community: the permanent Discord invite -->
              <StackPanel Spacing="8">
                <TextBlock Text="{Tr Support.Community.Title}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Tr Support.Community.Text}" Classes="muted wrap" />
                <Button x:Name="SupportDiscordButton" Classes="ghost" Command="{Binding OpenDiscordCommand}" ToolTip.Tip="{Tr Support.Discord.Tip}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:GlyphIcon Kind="Icon.Discord" IconSize="16" Foreground="{DynamicResource DiscordBrush}" />
                    <TextBlock Text="{Tr Support.Discord}" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- Support the developer -->
              <StackPanel Spacing="8">
                <TextBlock Text="{Tr Support.Donate.Title}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Tr Support.Donate.Text}" Classes="muted wrap" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Button x:Name="PayPalButton" Classes="accent" Command="{Binding OpenPayPalCommand}" ToolTip.Tip="{Tr Support.PayPal.Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:GlyphIcon Kind="Icon.Heart" IconSize="14" />
                      <TextBlock Text="{Tr Support.PayPal}" />
                    </StackPanel>
                  </Button>
                  <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Static vm:MainWindowViewModel.SupportEmail}" Classes="mono" />
                  </Border>
                  <Button Grid.Column="2" Classes="ghost small" Content="{Tr Common.Copy}" Command="{Binding CopyEmailCommand}" ToolTip.Tip="{Tr Support.Email.Tip}" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <Border Classes="hsep" />
              <!-- Report a problem -->
              <StackPanel Spacing="8">
                <TextBlock Text="{Tr Support.Report.Title}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Tr Support.Report.Text}" Classes="muted wrap" />
                <StackPanel Spacing="8" IsVisible="{Binding CanReport}">
                  <ComboBox x:Name="ReportCategoryBox" ItemsSource="{Binding ReportCategories}" SelectedItem="{Binding SelectedReportCategory}" MinWidth="180" HorizontalAlignment="Left" ToolTip.Tip="{Tr Support.Report.Category.Tip}" />
                  <TextBox x:Name="ReportBox" Text="{Binding ReportText}" AcceptsReturn="True" TextWrapping="Wrap" Height="130" MaxLength="1500"
                           Watermark="{Tr Support.Report.Watermark}" ToolTip.Tip="{Tr Support.Report.Box.Tip}" />
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <CheckBox IsChecked="{Binding ReportIncludeDetails}" Content="{Tr Support.Report.Details}" ToolTip.Tip="{Tr Support.Report.Details.Tip}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ReportLengthText}" Classes="caption mono" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Button Grid.Column="2" x:Name="SendReportButton" Classes="accent" Command="{Binding SendReportCommand}" ToolTip.Tip="{Tr Support.Report.Send.Tip}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:GlyphIcon Kind="Icon.Send" IconSize="14" />
                        <TextBlock Text="{Tr Support.Report.Send}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding ReportStatus}" Classes="caption wrap" />
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding !CanReport}">
                  <TextBlock Text="{Tr Support.Report.Unavailable}" Classes="caption wrap" />
                  <Button Classes="ghost" HorizontalAlignment="Left" Content="{Tr Support.Report.Issues}" Command="{Binding OpenIssuesCommand}" ToolTip.Tip="{Tr Support.Report.Issues.Tip}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>

    <!-- ===================================================================== What's new (once, after an update) -->
    <Panel x:Name="WhatsNewOverlay" IsVisible="{Binding IsWhatsNewOpen}" ZIndex="22">
      <Border Background="{DynamicResource ScrimBrush}" />
      <Border Classes="dialog" Width="620" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="24,20,24,16" BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <Border Classes="iconTile" Width="44" Height="44" CornerRadius="{DynamicResource SmallCornerRadius}">
                <c:GlyphIcon Kind="Icon.Star" IconSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding WhatsNewTitle}" Classes="h1" FontSize="19" />
                <TextBlock Text="{Tr Update.WhatsNewSubtitle}" Classes="muted wrap" FontSize="12.5" />
              </StackPanel>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="24,14" BorderBrush="{DynamicResource StrokeSubtleBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource Bg1Brush}">
            <Button x:Name="WhatsNewClose" HorizontalAlignment="Right" Classes="accent" Content="{Tr Update.Great}" Command="{Binding CloseWhatsNewCommand}" ToolTip.Tip="{Tr Update.Great.Tip}" />
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding WhatsNew}" Margin="24,10,24,18">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NoteLine">
                  <Panel>
                    <TextBlock Text="{Binding Text}" IsVisible="{Binding IsHeading}" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,4" TextWrapping="Wrap" />
                    <Grid IsVisible="{Binding IsBullet}" ColumnDefinitions="16,*" Margin="0,3">
                      <Border Width="5" Height="5" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,7,0,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding Text}" IsVisible="{Binding IsText}" Classes="muted" TextWrapping="Wrap" Margin="0,3" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </Panel>
</Window>
