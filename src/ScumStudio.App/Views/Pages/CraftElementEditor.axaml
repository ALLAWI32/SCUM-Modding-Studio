<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScumStudio.App.ViewModels"
             x:Class="ScumStudio.App.Views.Pages.CraftElementEditor"
             x:DataType="vm:CraftableRowViewModel">
  <StackPanel Spacing="10">
    <!-- Where it shows up (Build / Craft / Both), the kind warning and how a built craftable is placed (like the game's, a flag, repair cost, place in front) are step 2 of the Craftables page; this is under More options. -->

    <!-- "Like the game's bed": the game's levels and the values each one stores, with Reset -->
    <Border Classes="card" Padding="12" IsVisible="{Binding IsElement}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Tr Craftables.Element.Title}" Classes="h3" />
        <TextBlock Text="{Binding ElementNote}" Classes="caption wrap" IsVisible="{Binding ElementNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Spacing="8" DataContext="{Binding Element}" x:DataType="vm:ElementEditorViewModel"
                    IsVisible="{Binding $parent[UserControl].((vm:CraftableRowViewModel)DataContext).HasElement}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Like}" Classes="muted" VerticalAlignment="Center" />
            <Border x:Name="CraftElementRespawn" Classes="badge ok" IsVisible="{Binding IsRespawnPoint}" ToolTip.Tip="{Tr Craftables.Element.Respawn.Tip}">
              <TextBlock Text="{Tr Craftables.Element.Respawn}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Tr Craftables.Element.Levels}" Classes="caption" IsVisible="{Binding HasLevels}" />
          <ListBox x:Name="CraftElementLevels" Classes="plain" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" IsVisible="{Binding HasLevels}"
                   ToolTip.Tip="{Tr Craftables.Element.Levels.Tip}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ElementLevelViewModel">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Spacing="4" DataContext="{Binding SelectedLevel}" x:DataType="vm:ElementLevelViewModel">
            <ItemsControl x:Name="CraftElementValues" ItemsSource="{Binding Values}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ElementValueViewModel">
                  <Grid ColumnDefinitions="220,150,*,Auto" ColumnSpacing="10" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}" />
                    <NumericUpDown Grid.Column="1" Value="{Binding Number}" Minimum="-79228162514264337593543950335" Maximum="79228162514264337593543950335" Increment="1" FormatString="0.###" IsVisible="{Binding IsNumber}"
                                   ToolTip.Tip="{Binding Tip}" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding Flag}" IsVisible="{Binding IsFlag}" ToolTip.Tip="{Binding Tip}" />
                    <TextBlock Grid.Column="2" Text="{Binding StockText}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="3" Classes="ghost" Content="{Tr Craftables.Element.Reset}" ToolTip.Tip="{Tr Craftables.Element.Reset.Tip}" Command="{Binding ResetCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption wrap" Text="{Binding InheritedText}" IsVisible="{Binding HasInherited}" ToolTip.Tip="{Tr Craftables.Element.Inherited.Tip}" />
          </StackPanel>
          <!-- What the item it spawns holds (a chest's size; defolt_0999's large fridge) -->
          <StackPanel x:Name="CraftStorage" Spacing="4" IsVisible="{Binding HasStorage}">
            <TextBlock Text="{Tr Craftables.Storage.Title}" Classes="caption" ToolTip.Tip="{Tr Craftables.Storage.Tip}" />
            <TextBlock x:Name="CraftStorageFridge" Text="{Tr Craftables.Storage.Fridge}" Classes="caption wrap" IsVisible="{Binding IsFridge}" ToolTip.Tip="{Tr Craftables.Storage.Tip}" />
            <ItemsControl x:Name="CraftStorageValues" ItemsSource="{Binding Storage}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ElementValueViewModel">
                  <Grid ColumnDefinitions="220,150,*,Auto" ColumnSpacing="10" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tip}" />
                    <NumericUpDown Grid.Column="1" Value="{Binding Number}" Minimum="0" Maximum="1000000" Increment="1" FormatString="0.###" ToolTip.Tip="{Binding Tip}" />
                    <TextBlock Grid.Column="2" Text="{Binding StockText}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="3" Classes="ghost" Content="{Tr Craftables.Element.Reset}" ToolTip.Tip="{Tr Craftables.Element.Reset.Tip}" Command="{Binding ResetCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
