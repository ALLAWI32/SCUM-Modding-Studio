<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScumStudio.App.ViewModels"
             xmlns:c="using:ScumStudio.App.Controls"
             xmlns:conv="using:ScumStudio.App.Converters"
             xmlns:p="using:ScumStudio.App.Views.Pages"
             x:Class="ScumStudio.App.Views.Pages.CraftablesPageView"
             x:DataType="vm:CraftablesPageViewModel">
  <UserControl.Styles>
    <!-- Craftable rows: the 3D picture of the mesh, the name and what it is. -->
    <Style Selector="Border.craftThumb">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Background" Value="{DynamicResource Bg1Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.craftHero">
      <Setter Property="Width" Value="168" />
      <Setter Property="Height" Value="168" />
      <Setter Property="Background" Value="{DynamicResource Bg1Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- ===== Header ===== -->
    <Border DockPanel.Dock="Top" Classes="pageHeader">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Grid.Column="0" Classes="pageGlyph"><c:GlyphIcon Kind="{Binding IconKey}" IconSize="22" /></Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Classes="pageTitle" />
          <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Tr Craftables.NoProject}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding !HasProject}" />
          <Border Classes="segmented" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="CraftRecipeTab" IsChecked="{Binding !IsGalleryOpen}" IsEnabled="{Binding HasSelection}" Content="{Tr Craftables.Recipe}"
                            ToolTip.Tip="{Tr Craftables.Recipe.Tip}" />
              <ToggleButton x:Name="CraftGalleryTab" IsChecked="{Binding IsGalleryOpen}" Content="{Tr Craftables.Gallery}"
                            ToolTip.Tip="{Tr Craftables.Gallery.Tip}" />
            </StackPanel>
          </Border>
          <ToggleButton x:Name="CraftStockTab" IsChecked="{Binding IsStockOpen}" Content="{Tr Craftables.Stock}" ToolTip.Tip="{Tr Craftables.Stock.Tip}" />
          <Button x:Name="CraftUndoButton" Classes="ghost" Command="{Binding UndoCommand}" Content="{Tr Craftables.Undo}" ToolTip.Tip="{Tr Craftables.Undo.Tip}" />
        </StackPanel>
      </Grid>
    </Border>

    <Panel Margin="24,0,24,20">
      <Border Classes="emptyState" IsVisible="{Binding !HasCatalog}">
        <StackPanel Spacing="12">
          <TextBlock Text="{Tr Module.Empty}" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Classes="muted wrap" TextAlignment="Center" MaxWidth="520" Text="{Tr Craftables.Empty.Body}" />
          <Button Classes="accent" HorizontalAlignment="Center" Content="{Tr Common.OpenSetup}" Command="{Binding OpenSetupCommand}" ToolTip.Tip="{Tr Common.OpenSetup.Tip}" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="340,*" ColumnSpacing="12" IsVisible="{Binding HasCatalog}">
        <!-- The list and the Add box -->
        <Border Grid.Column="0" Classes="panel">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="panelHeader">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:GlyphIcon Kind="Icon.List" IconSize="16" VerticalAlignment="Center" />
                <TextBlock Text="{Tr Craftables.List}" Classes="h3" VerticalAlignment="Center" />
                <Border Classes="badge"><TextBlock Text="{Binding Items.Count}" /></Border>
              </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="8,8,8,6">
              <TextBox x:Name="CraftAddSearch" Classes="search" Text="{Binding AddQuery}" Watermark="{Tr Craftables.Add.Watermark}" ToolTip.Tip="{Tr Craftables.Add.Tip}" />
              <ListBox x:Name="CraftAddResults" Classes="plain" ItemsSource="{Binding AddResults}" MaxHeight="180" IsVisible="{Binding HasAddResults}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CraftSourceRow">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Content="{Tr Craftables.Add}" ToolTip.Tip="{Tr Craftables.AddOne.Tip}"
                              Command="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).AddSourceCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <!-- External 3D files (FBX, OBJ) cooked by Unreal Engine 4.27; the status bar shows the engine's progress. -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <Button x:Name="CraftImportButton" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{Tr Craftables.Import}"
                        ToolTip.Tip="{Tr Craftables.Import.Tip}" Command="{Binding ImportModelCommand}" />
                <Button x:Name="CraftImportCancel" Grid.Column="1" Classes="ghost" Content="{Tr Craftables.Import.Cancel}" ToolTip.Tip="{Tr Craftables.Import.Cancel.Tip}"
                        Command="{Binding CancelImportCommand}" IsVisible="{Binding IsImporting}" />
              </Grid>
              <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" IsVisible="{Binding IsImporting}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Classes="caption wrap" Text="{Tr Craftables.Note}" Margin="10,6,10,8" />
            <ListBox x:Name="CraftList" Classes="plain" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="4,0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CraftableRowViewModel">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="2,3">
                    <Border Grid.Column="0" Classes="craftThumb">
                      <c:ThumbnailImage Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Caption}" Classes="caption" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Classes="chip"><TextBlock x:Name="CraftKindChip" Text="{Binding KindChoice.Label}" /></Border>
                        <Border Classes="chip"><TextBlock x:Name="CraftMaterialChip" Text="{Binding MaterialChoice.Label}" /></Border>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- The selected craftable, or the gallery of everything the game has (always while none is selected) -->
        <Border Grid.Column="1" Classes="panel">
          <Panel>
            <!-- Gallery: the Assets page's categories and tiles (rows virtualized, pictures made for the tiles on screen) -->
            <Grid ColumnDefinitions="260,*" Margin="4,6,0,0" DataContext="{Binding Gallery}" x:DataType="vm:CraftGalleryViewModel"
                  IsVisible="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).IsGalleryOpen}">
              <TreeView Grid.Column="0" x:Name="CraftGalleryTree" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedCategory}" Margin="4">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem" x:DataType="vm:ObjectCategoryNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="vm:ObjectCategoryNode" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                      <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="caption" VerticalAlignment="Center" Margin="0,0,6,0" />
                    </Grid>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <DockPanel Grid.Column="1" Margin="8,8,0,0">
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,10,8">
                  <TextBox x:Name="CraftGallerySearch" Classes="search" Text="{Binding Query}" Watermark="{Tr Craftables.Gallery.Search}" ToolTip.Tip="{Tr Assets.Filter.Tip}" />
                  <TextBlock Text="{Tr Craftables.Gallery.Hint}" Classes="caption wrap" />
                  <TextBlock Text="{Binding ResultText}" Classes="muted" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                </StackPanel>
                <ScrollViewer x:Name="CraftGalleryScroll" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="CraftGalleryGrid" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AssetTileRow">
                        <ItemsControl ItemsSource="{Binding Tiles}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AssetItemViewModel">
                              <Button Classes="tile" Classes.selected="{Binding IsAdded}" ToolTip.Tip="{Binding Entry.PackagePath}"
                                      Command="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).Gallery.AddCommand}" CommandParameter="{Binding}">
                                <StackPanel Width="120" Spacing="5">
                                  <Border Height="120" CornerRadius="{DynamicResource SmallCornerRadius}" Background="{DynamicResource ViewportBrush}" ClipToBounds="True">
                                    <Panel>
                                      <c:GlyphIcon Kind="{Binding IconKey}" IconSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Tint, Converter={x:Static conv:HexBrushConverter.Instance}}"
                                                   IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                                      <c:ThumbnailImage Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                                      <Border Classes="badge accent" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" IsVisible="{Binding IsAdded}">
                                        <TextBlock Text="{Tr Craftables.Gallery.Added}" />
                                      </Border>
                                    </Panel>
                                  </Border>
                                  <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding ClassName}" Classes="caption" FontSize="10.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Grid>

            <ScrollViewer x:Name="CraftEditorScroll" IsVisible="{Binding !IsGalleryOpen}" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,12" Spacing="10" DataContext="{Binding SelectedItem}" x:DataType="vm:CraftableRowViewModel">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                  <Border Grid.Column="0" Classes="craftHero" VerticalAlignment="Top">
                    <c:ThumbnailImage Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="{Tr Craftables.Name}" Classes="caption" />
                    <TextBox x:Name="CraftNameBox" Text="{Binding Name}" ToolTip.Tip="{Tr Craftables.Name.Tip}" />
                    <!-- HexTer: own asset names and folders, chosen until the first export (then the game saves built objects by them) -->
                    <WrapPanel x:Name="CraftAssetPanel" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Tr Craftables.AssetNameLabel}" Classes="caption" />
                        <TextBox x:Name="CraftAssetNameBox" MinWidth="220" Classes="mono" Text="{Binding AssetNameText}" IsReadOnly="{Binding IsLocked}"
                                 ToolTip.Tip="{Tr Craftables.AssetName.Tip}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Tr Craftables.Folder}" Classes="caption" />
                        <AutoCompleteBox x:Name="CraftFolderBox" MinWidth="180" Text="{Binding FolderText, Mode=TwoWay}" FilterMode="StartsWith" MinimumPrefixLength="0"
                                         IsEnabled="{Binding CanRename}" Watermark="{Tr Craftables.Folder.None}" ToolTip.Tip="{Tr Craftables.Folder.Tip}"
                                         ItemsSource="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).Folders}" />
                      </StackPanel>
                      <Border x:Name="CraftLocked" Classes="badge" VerticalAlignment="Bottom" IsVisible="{Binding IsLocked}" ToolTip.Tip="{Tr Craftables.Locked.Tip}">
                        <TextBlock Text="{Tr Craftables.Locked}" />
                      </Border>
                    </WrapPanel>
                    <TextBlock x:Name="CraftNameProblem" Text="{Binding NameProblem}" Classes="warn caption wrap"
                               IsVisible="{Binding NameProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock x:Name="CraftFolderProblem" Text="{Binding FolderProblem}" Classes="warn caption wrap"
                               IsVisible="{Binding FolderProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock x:Name="CraftAssetName" Text="{Binding PathPreview}" Classes="caption mono" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Tr Craftables.AssetName.Tip}" />
                    <TextBlock x:Name="CraftTokenTaken" Text="{Binding TokenTaken}" Classes="warn caption wrap"
                               IsVisible="{Binding TokenTaken, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Source}" Classes="caption mono" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Tr Craftables.ItemNote}" Classes="caption wrap" IsVisible="{Binding IsItem}" />
                    <WrapPanel x:Name="CraftEditorOptions" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Tr Craftables.Kind}" Classes="caption" />
                        <!-- Kinds and materials by their names in the current language (F138: the enum names showed). -->
                        <ComboBox x:Name="CraftKindBox" MinWidth="150" SelectedItem="{Binding KindChoice}" ToolTip.Tip="{Tr Craftables.Kind.Tip}" ItemsSource="{Binding KindChoices}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CraftChoice">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Tr Craftables.Material}" Classes="caption" />
                        <ComboBox x:Name="CraftMaterialBox" MinWidth="150" SelectedItem="{Binding MaterialChoice}" ToolTip.Tip="{Tr Craftables.Material.Tip}"
                                  ItemsSource="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).MaterialChoices}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CraftChoice">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <!-- The section of the game's crafting menu: only the game's own (an unregistered tag is invalid). -->
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Tr Craftables.ShowsIn}" Classes="caption" />
                        <ComboBox x:Name="CraftShowsInBox" MinWidth="220" MaxWidth="340" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                                  ToolTip.Tip="{Tr Craftables.ShowsIn.Tip}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CraftSectionChoice">
                              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <!-- The picture the crafting menu shows (Jenni: every craftable showed the improvised chair's): empty = its own. -->
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Tr Craftables.Picture}" Classes="caption" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <AutoCompleteBox x:Name="CraftPictureBox" MinWidth="220" MaxWidth="340" Text="{Binding Icon, Mode=TwoWay}" FilterMode="Contains" MinimumPrefixLength="2"
                                           Watermark="{Tr Craftables.Picture.Own}" ToolTip.Tip="{Tr Craftables.Picture.Tip}"
                                           ItemsSource="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).Pictures}" />
                          <Button x:Name="CraftPictureReset" Classes="plain" Content="{Tr Craftables.Picture.Reset}" Command="{Binding ResetIconCommand}"
                                  ToolTip.Tip="{Tr Craftables.Picture.Reset.Tip}" />
                          <!-- Jenni and the owner: "a bed must show a bed": drawn from its 3D model, or a picture of the user's. -->
                          <Button x:Name="CraftPictureModel" Classes="plain" Content="{Tr Craftables.Picture.Model}" Command="{Binding UseModelPictureCommand}"
                                  ToolTip.Tip="{Tr Craftables.Picture.Model.Tip}" />
                          <Button x:Name="CraftPictureImport" Classes="plain" Content="{Tr Craftables.Picture.Import}"
                                  Command="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).ImportPictureCommand}" CommandParameter="{Binding}"
                                  ToolTip.Tip="{Tr Craftables.Picture.Import.Tip}" />
                        </StackPanel>
                        <TextBlock x:Name="CraftPictureNote" Classes="caption" Text="{Binding PictureNote}" IsVisible="{Binding PictureNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   TextWrapping="Wrap" MaxWidth="460" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Tr Craftables.MadeIn}" Classes="caption" />
                        <Panel MinHeight="32">
                          <Border x:Name="CraftMadeInBuilding" Classes="badge" VerticalAlignment="Center" HorizontalAlignment="Left" IsVisible="{Binding IsBuilding}"
                                  ToolTip.Tip="{Tr Craftables.MadeIn.Building.Tip}">
                            <TextBlock Text="{Tr Craftables.MadeIn.Building}" />
                          </Border>
                          <Border x:Name="CraftMadeInCrafting" Classes="badge" VerticalAlignment="Center" HorizontalAlignment="Left" IsVisible="{Binding !IsBuilding}"
                                  ToolTip.Tip="{Tr Craftables.MadeIn.Crafting.Tip}">
                            <TextBlock Text="{Tr Craftables.MadeIn.Crafting}" />
                          </Border>
                        </Panel>
                      </StackPanel>
                      <StackPanel Spacing="2" IsVisible="{Binding IsBuilt}">
                        <TextBlock Text="{Tr Craftables.Station}" Classes="caption" />
                        <ComboBox x:Name="CraftStationBox" MinWidth="170" SelectedItem="{Binding Station}" ToolTip.Tip="{Tr Craftables.Station.Tip}"
                                  ItemsSource="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).Stations}" />
                      </StackPanel>
                    </WrapPanel>
                    <CheckBox IsChecked="{Binding NeedsPower}" IsVisible="{Binding IsBuilt}" ToolTip.Tip="{Tr Craftables.NeedsPower.Tip}">
                      <TextBlock Text="{Tr Craftables.NeedsPower}" TextWrapping="Wrap" />
                    </CheckBox>
                  </StackPanel>
                </Grid>

                <p:CraftElementEditor x:Name="CraftElementEditor" />

                <!-- Power objects: the green circle, what they give and their fuel. -->
                <Border Classes="card" IsVisible="{Binding IsPower}" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Tr Craftables.Power}" Classes="h3" />
                    <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Tr Craftables.Radius}" Classes="caption" />
                        <NumericUpDown x:Name="CraftRadiusBox" Value="{Binding Radius}" Minimum="1" Maximum="500" Increment="1" Width="140" ToolTip.Tip="{Tr Craftables.Radius.Tip}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Tr Craftables.Output}" Classes="caption" />
                        <NumericUpDown x:Name="CraftOutputBox" Value="{Binding Output}" Minimum="1" Maximum="100000" Increment="50" Width="140" ToolTip.Tip="{Tr Craftables.Output.Tip}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Tr Craftables.Fuel}" Classes="caption" />
                        <NumericUpDown x:Name="CraftFuelBox" Value="{Binding Fuel}" Minimum="0" Maximum="100" Increment="0.05" FormatString="0.#####" Width="140" ToolTip.Tip="{Tr Craftables.Fuel.Tip}" />
                      </StackPanel>
                    </WrapPanel>
                    <CheckBox IsChecked="{Binding DayOnly}" ToolTip.Tip="{Tr Craftables.DayOnly.Tip}">
                      <TextBlock Text="{Tr Craftables.DayOnly}" TextWrapping="Wrap" />
                    </CheckBox>
                  </StackPanel>
                </Border>

                <!-- The recipe -->
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="{Tr Craftables.Recipe}" Classes="h3" VerticalAlignment="Center" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Classes="ghost" Content="{Tr Craftables.Suggest}" ToolTip.Tip="{Tr Craftables.Suggest.Tip}"
                            Command="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).SuggestRecipeCommand}" />
                    <Button x:Name="CraftAddIngredientButton" Classes="ghost" Content="{Tr Craftables.AddIngredient}" ToolTip.Tip="{Tr Craftables.AddIngredient.Tip}"
                            Command="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).PickIngredientCommand}" />
                  </StackPanel>
                </DockPanel>
                <TextBlock x:Name="CraftLevelsNote" Text="{Tr Craftables.Levels.Note}" Classes="caption wrap" />
                <!-- Each ingredient as its 3D picture, how the game knows it (badge), amount, tool, Change and Remove; per level below. -->
                <ItemsControl x:Name="CraftIngredients" ItemsSource="{Binding Ingredients}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IngredientRowViewModel">
                      <StackPanel Spacing="2" Margin="0,3">
                      <Grid ColumnDefinitions="Auto,*,110,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <Border Grid.Column="0" Classes="craftThumb">
                          <Panel DataContext="{Binding Picture}" x:DataType="vm:IngredientTileViewModel">
                            <c:GlyphIcon Kind="{Binding IconKey}" IconSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{Binding Tint, Converter={x:Static conv:HexBrushConverter.Instance}}"
                                         IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                            <c:ThumbnailImage Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Item}" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Classes="chip" IsVisible="{Binding HasBadge}" ToolTip.Tip="{Binding BadgeTip}"><TextBlock Text="{Binding BadgeText}" /></Border>
                            <TextBlock Text="{Binding Detail}" Classes="caption mono" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </StackPanel>
                        <NumericUpDown Grid.Column="2" Value="{Binding Amount}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" VerticalAlignment="Center" ToolTip.Tip="{Tr Craftables.Amount.Tip}"
                                       IsVisible="{Binding !PerLevel}" />
                        <CheckBox Grid.Column="3" IsChecked="{Binding IsTool}" Content="{Tr Craftables.Tool}" ToolTip.Tip="{Tr Craftables.Tool.Tip}" />
                        <CheckBox x:Name="CraftPerLevel" Grid.Column="4" IsChecked="{Binding PerLevel}" Content="{Tr Craftables.Levels.PerLevel}" ToolTip.Tip="{Tr Craftables.Levels.PerLevel.Tip}" />
                        <Button Grid.Column="5" Classes="ghost" Content="{Tr Craftables.Ingredient.Change}" ToolTip.Tip="{Tr Craftables.Ingredient.Change.Tip}"
                                Command="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).ChangeIngredientCommand}" CommandParameter="{Binding}" />
                        <Button Grid.Column="6" Classes="ghost" Content="{Tr Craftables.RemoveIngredient}" Command="{Binding RemoveCommand}" ToolTip.Tip="{Tr Craftables.RemoveIngredient.Tip}" />
                      </Grid>
                      <Panel Margin="64,0,0,0" IsVisible="{Binding PerLevel}">
                        <p:SkillLevelsEditor DataContext="{Binding Levels}" />
                      </Panel>
                      <TextBlock x:Name="CraftAutoLevels" Text="{Binding AutoLevelsText}" Classes="caption" Margin="64,0,0,0" IsVisible="{Binding !PerLevel}"
                                 ToolTip.Tip="{Tr Craftables.Levels.Auto.Tip}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="CraftRemoveButton" Classes="danger" HorizontalAlignment="Left" Content="{Tr Craftables.Remove}" ToolTip.Tip="{Tr Craftables.Remove.Tip}"
                        Command="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).RemoveCommand}" />
              </StackPanel>
            </ScrollViewer>

            <p:CraftIngredientPicker x:Name="CraftIngredientPicker" DataContext="{Binding Picker}" />

            <!-- The game's own recipes with the user's amounts per skill level: an explicit override, shipped at the game's path. -->
            <Border x:Name="CraftStockPanel" Classes="dialog" Margin="6" IsVisible="{Binding IsStockOpen}">
              <DockPanel Margin="12">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                  <Button x:Name="CraftStockClose" DockPanel.Dock="Right" Classes="ghost" VerticalAlignment="Top" Content="{Tr Craftables.Stock.Close}"
                          ToolTip.Tip="{Tr Craftables.Stock.Close.Tip}" Command="{Binding CloseStockCommand}" />
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Tr Craftables.Stock.Title}" Classes="h3" />
                    <TextBlock Text="{Tr Craftables.Stock.Hint}" Classes="caption wrap" />
                    <TextBlock x:Name="CraftStockWarning" Text="{Tr Craftables.Stock.Warning}" Classes="warn caption wrap" />
                  </StackPanel>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                  <TextBox x:Name="CraftStockSearch" Classes="search" Text="{Binding StockQuery}" Watermark="{Tr Craftables.Stock.Search}" ToolTip.Tip="{Tr Craftables.Stock.Search.Tip}" />
                  <ListBox x:Name="CraftStockResults" Classes="plain" ItemsSource="{Binding StockResults}" MaxHeight="160" IsVisible="{Binding HasStockResults}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:StockRecipeChoice">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Folder}" Classes="caption" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="ghost" Content="{Tr Craftables.Stock.Add}" ToolTip.Tip="{Tr Craftables.Stock.Add.Tip}"
                                  Command="{Binding $parent[UserControl].((vm:CraftablesPageViewModel)DataContext).AddStockRecipeCommand}" CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="{Tr Craftables.Stock.None}" Classes="muted" IsVisible="{Binding HasNoRecipeOverrides}" />
                </StackPanel>
                <ScrollViewer x:Name="CraftStockScroll" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="CraftStockRecipes" ItemsSource="{Binding RecipeOverrides}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StockRecipeRowViewModel">
                        <Border Classes="card" Padding="10" Margin="0,0,0,8">
                          <StackPanel Spacing="6">
                            <DockPanel>
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="CraftStockReset" Classes="ghost" Content="{Tr Craftables.Stock.Reset}" ToolTip.Tip="{Tr Craftables.Stock.Reset.Tip}" Command="{Binding ResetToGameCommand}" />
                                <Button x:Name="CraftStockRemove" Classes="ghost" Content="{Tr Craftables.Stock.Remove}" ToolTip.Tip="{Tr Craftables.Stock.Remove.Tip}" Command="{Binding RemoveCommand}" />
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Recipe}" />
                                <Border Classes="chip" VerticalAlignment="Center" ToolTip.Tip="{Tr Craftables.Stock.Skill.Tip}"><TextBlock Text="{Binding SkillText}" /></Border>
                              </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Problem}" Classes="warn caption wrap" IsVisible="{Binding HasProblem}" />
                            <ItemsControl ItemsSource="{Binding Slots}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StockSlotRowViewModel">
                                  <StackPanel Spacing="2" Margin="0,3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <TextBlock Text="{Binding Title}" Classes="mono" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                      <Border Classes="chip" IsVisible="{Binding IsTool}" ToolTip.Tip="{Tr Craftables.Tool.Tip}"><TextBlock Text="{Tr Craftables.Tool}" /></Border>
                                      <TextBlock Text="{Binding GameText}" Classes="caption" VerticalAlignment="Center" ToolTip.Tip="{Tr Craftables.Stock.Game.Tip}" />
                                    </StackPanel>
                                    <p:SkillLevelsEditor DataContext="{Binding Levels}" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Panel>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
