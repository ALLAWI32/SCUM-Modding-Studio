<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScumStudio.App.ViewModels"
             xmlns:c="using:ScumStudio.App.Controls"
             x:Class="ScumStudio.App.Views.Pages.EconomyPageView"
             x:DataType="vm:EconomyPageViewModel">
  <UserControl.Styles>
    <!-- Stock rows: a picture tile, a mark on the left edge (changed, added, not in the game files), dimmed when off sale. -->
    <Style Selector="Border.itemRow">
      <Setter Property="Padding" Value="6,4,10,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
    </Style>
    <Style Selector="Border.itemRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    </Style>
    <Style Selector="Border.itemRow.changed">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.itemRow.off">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.itemRow.off TextBlock.itemName">
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="Border.mark">
      <Setter Property="Width" Value="3" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.itemRow.changed Border.mark">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.itemRow.added Border.mark">
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.itemRow.unknown Border.mark">
      <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Border.thumb">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.thumb c|GlyphIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <!-- Trader cards: the type glyph in a tile (blaze for the project's own traders) and the map cell. -->
    <Style Selector="Border.typeTile">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.typeTile.placed">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.typeTile.unknown">
      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Border.typeTile.hero">
      <Setter Property="Width" Value="54" />
      <Setter Property="Height" Value="54" />
    </Style>
    <Style Selector="Border.typeTile c|GlyphIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.typeTile.placed c|GlyphIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="TextBox.price">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBox.price.invalid /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <!-- A value's Reset: a small glyph left of its box, there only while the value is not what Reset writes. -->
    <Style Selector="Button.valueReset">
      <Setter Property="Padding" Value="2" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The Code view: the file as the export writes it, tabs and all. -->
    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBlock.problem.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.problem.warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- ===== Header ===== -->
    <Border DockPanel.Dock="Top" Classes="pageHeader">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Grid.Column="0" Classes="pageGlyph"><c:GlyphIcon Kind="{Binding IconKey}" IconSize="22" /></Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Classes="pageTitle" />
          <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="segmented" VerticalAlignment="Center" IsVisible="{Binding HasCatalog}">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="EconomyNumbersTab" IsChecked="{Binding !IsCodeView}" Content="{Tr Economy.View.Numbers}" ToolTip.Tip="{Tr Economy.View.Tip}" />
              <ToggleButton x:Name="EconomyCodeTab" IsChecked="{Binding IsCodeView}" Content="{Tr Economy.View.Code}" ToolTip.Tip="{Tr Economy.View.Tip}" />
            </StackPanel>
          </Border>
          <!-- Owner: "I don't see where to spawn a trader": a trader of any type goes on the Map where its camera aims -->
          <Button x:Name="PlaceTraderMenuButton" Classes="ghost" ToolTip.Tip="{Tr Economy.PlaceTrader.Tip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GlyphIcon Kind="Icon.Plus" IconSize="14" />
              <TextBlock Text="{Tr Economy.PlaceTrader}" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="6" Width="260">
                  <TextBlock Text="{Tr Economy.PlaceTrader.Caption}" Classes="caption wrap" />
                  <ItemsControl x:Name="PlaceTraderList" ItemsSource="{Binding PlaceableTraders}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TraderTypeItem">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,1"
                                Command="{Binding $parent[ItemsControl].((vm:EconomyPageViewModel)DataContext).PlaceTraderCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="{Tr Economy.PlaceTrader.Tip}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:GlyphIcon Kind="Icon.Map" IconSize="13" />
                            <TextBlock Text="{Binding Label}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- Discord: "the economy doesn't have a way to upload its own economy file" -->
          <Button x:Name="EconomyImportButton" Classes="accent" Command="{Binding ImportCommand}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Tr Economy.Import.Tip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GlyphIcon Kind="Icon.Download" IconSize="14" />
              <TextBlock Text="{Tr Economy.Import}" />
            </StackPanel>
          </Button>
          <Button x:Name="EconomyExportButton" Classes="accent" Command="{Binding ExportCommand}" ToolTip.Tip="{Tr Economy.Export.Tip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GlyphIcon Kind="Icon.Export" IconSize="14" />
              <TextBlock Text="{Tr Economy.Export}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Without a project nothing can be kept: every editor is off and this says why (F299). -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="24,0,24,10" Padding="12,8" IsVisible="{Binding !CanEdit}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <c:GlyphIcon Kind="Icon.Warning" IconSize="14" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Tr Economy.NoProject}" Classes="wrap" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- What the last import changed, until dismissed. -->
    <Border DockPanel.Dock="Top" x:Name="ImportSummaryCard" Classes="card" Margin="24,0,24,10" Padding="12,8" IsVisible="{Binding HasImportSummary}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <c:GlyphIcon Grid.Column="0" Kind="Icon.Download" IconSize="16" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{Binding ImportSummary.Title, FallbackValue=''}" FontWeight="SemiBold" Classes="wrap" />
          <TextBlock Text="{Binding ImportSummary.Traders, FallbackValue=''}" Classes="caption mono wrap" IsVisible="{Binding ImportSummary.HasTraders, FallbackValue=False}" />
          <TextBlock Text="{Binding ImportSummary.Detail, FallbackValue=''}" Classes="caption wrap" />
        </StackPanel>
        <Button Grid.Column="2" Classes="ghost square" VerticalAlignment="Top" Command="{Binding DismissImportCommand}" ToolTip.Tip="{Tr Economy.Import.Dismiss.Tip}">
          <c:GlyphIcon Kind="Icon.Close" IconSize="13" />
        </Button>
      </Grid>
    </Border>

    <!-- ===== Body ===== -->
    <Panel Margin="24,0,24,20">

      <!-- No game files yet (the traders and their stock come from them). -->
      <Border Classes="emptyState" IsVisible="{Binding !HasCatalog}">
        <StackPanel Spacing="12">
          <Border Classes="iconTile" HorizontalAlignment="Center">
            <c:GlyphIcon Kind="Icon.Coins" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Tr Module.Empty}" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Classes="muted wrap" TextAlignment="Center" MaxWidth="520" Text="{Tr Economy.Empty.Body}" />
          <Button Classes="accent" HorizontalAlignment="Center" Content="{Tr Common.OpenSetup}" Command="{Binding OpenSetupCommand}" ToolTip.Tip="{Tr Common.OpenSetup.Tip}" />
        </StackPanel>
      </Border>

      <!-- ===== Code: the project's EconomyOverride.json, checked as it is typed ===== -->
      <Border x:Name="CodePanel" Classes="panel" IsVisible="{Binding IsCodeShown}">
        <DockPanel Margin="14,12,14,10">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Ellipse Classes="dot" Classes.ok="{Binding IsCodeValid}" Classes.error="{Binding HasCodeErrors}" Classes.warn="{Binding HasCodeWarningsOnly}" />
              <TextBlock x:Name="CodeStatusText" Text="{Binding CodeStatus}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <ComboBox x:Name="CodeScopeBox" ItemsSource="{Binding CodeScopes}" SelectedItem="{Binding SelectedCodeScope}" MinWidth="190" ToolTip.Tip="{Tr Economy.Code.Scope.Tip}" />
              <ComboBox x:Name="CodeTraderBox" ItemsSource="{Binding Traders}" SelectedItem="{Binding SelectedTrader}" MinWidth="190"
                        IsVisible="{Binding IsTraderScope}" ToolTip.Tip="{Tr Economy.Code.Scope.Tip}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EconomyTraderRow">
                    <TextBlock Text="{Binding Name}" Classes="mono" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="CodeFormatButton" Classes="ghost" Command="{Binding FormatCodeCommand}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Tr Economy.Code.Format.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:GlyphIcon Kind="Icon.Check" IconSize="13" />
                  <TextBlock Text="{Tr Economy.Code.Format}" />
                </StackPanel>
              </Button>
              <Button x:Name="CodeDiscardButton" Classes="ghost" Command="{Binding DiscardCodeCommand}" ToolTip.Tip="{Tr Economy.Code.Discard.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:GlyphIcon Kind="Icon.Undo" IconSize="13" />
                  <TextBlock Text="{Tr Economy.Code.Discard}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Border DockPanel.Dock="Top" Classes="card" Padding="10,6" Margin="0,0,0,8" IsVisible="{Binding IsCodeDraft}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:GlyphIcon Kind="Icon.Warning" IconSize="14" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
              <TextBlock x:Name="CodeDraftText" Text="{Binding CodeDraftText}" Classes="wrap" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <ListBox DockPanel.Dock="Bottom" x:Name="ProblemList" Classes="plain" ItemsSource="{Binding Problems}" MaxHeight="170" Margin="0,8,0,0"
                   IsVisible="{Binding HasProblems}" SelectionChanged="OnProblemSelected">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EconomyProblemRow">
                <Grid ColumnDefinitions="Auto,130,*" ColumnSpacing="8" Margin="2,1" Background="Transparent" ToolTip.Tip="{Tr Economy.Code.Problem.Tip}">
                  <Ellipse Grid.Column="0" Classes="dot" Classes.error="{Binding IsError}" Classes.warn="{Binding !IsError}" />
                  <TextBlock Grid.Column="1" Text="{Binding Location}" Classes="mono caption" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Message}" Classes="problem wrap" Classes.error="{Binding IsError}" Classes.warning="{Binding !IsError}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBox x:Name="CodeBox" Classes="code" Text="{Binding CodeText}" IsReadOnly="{Binding !CanEdit}"
                   AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   LostFocus="OnCodeLostFocus" ToolTip.Tip="{Tr Economy.Code.Tip}" />
        </DockPanel>
      </Border>

      <!-- ===== Numbers ===== -->
      <Grid x:Name="EconomyBody" ColumnDefinitions="300,*" ColumnSpacing="12" IsVisible="{Binding IsNumbersShown}">
        <!-- Traders: one card each, by map cell -->
        <Border Grid.Column="0" Classes="panel">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,10,12,4">
              <TextBlock Text="{Tr Economy.Traders}" Classes="h3" VerticalAlignment="Center" />
              <Border Classes="badge"><TextBlock Text="{Binding Traders.Count}" /></Border>
            </StackPanel>
            <ToggleButton DockPanel.Dock="Top" x:Name="EconomySettingsButton" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="8,4"
                          IsChecked="{Binding IsSettingsOpen}" ToolTip.Tip="{Tr Economy.Settings.Tip}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:GlyphIcon Kind="Icon.Sliders" IconSize="14" />
                <TextBlock Text="{Tr Economy.Settings}" />
                <Border Classes="badge"><TextBlock Text="{Binding SettingRows.Count}" /></Border>
              </StackPanel>
            </ToggleButton>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Margin="12,4" />
            <Border DockPanel.Dock="Top" Classes="card" Margin="8,4" Padding="10,8" IsVisible="{Binding TablesFailed}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Tr Economy.TablesFailed}" Classes="wrap" FontWeight="SemiBold" />
                <Button x:Name="EconomyRetryButton" Classes="ghost" Command="{Binding RetryCommand}" ToolTip.Tip="{Tr Economy.Retry.Tip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:GlyphIcon Kind="Icon.Refresh" IconSize="13" />
                    <TextBlock Text="{Tr Economy.Retry}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <ListBox x:Name="TraderList" Classes="plain" ItemsSource="{Binding Traders}" SelectedItem="{Binding SelectedTrader}" Margin="4">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EconomyTraderRow">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="2,3">
                    <Border Grid.Column="0" Classes="typeTile" Classes.placed="{Binding IsPlaced}" Classes.unknown="{Binding IsUnknown}" VerticalAlignment="Center">
                      <c:GlyphIcon Kind="{Binding IconKey}" IconSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Caption}" Classes="caption" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding ChangesText}" Classes="caption accent" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasChanges}" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center" IsVisible="{Binding !IsUnknown}">
                      <TextBlock Text="{Binding Cell}" Classes="mono" />
                    </Border>
                    <Border Grid.Column="2" Classes="badge warn" VerticalAlignment="Center" IsVisible="{Binding IsUnknown}" ToolTip.Tip="{Tr Economy.UnknownTrader.Tip}">
                      <TextBlock Text="?" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- The server settings of the file: one row each, with its Reset -->
        <Border Grid.Column="1" x:Name="SettingsPanel" Classes="panel" IsVisible="{Binding IsSettingsOpen}">
          <DockPanel Margin="14,12,14,8">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
              <TextBlock Text="{Tr Economy.Settings}" Classes="h1" FontSize="20" />
              <TextBlock Text="{Tr Economy.Settings.Tip}" Classes="muted wrap" />
            </StackPanel>
            <ListBox x:Name="SettingList" Classes="plain" ItemsSource="{Binding SettingRows}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EconomySettingRow">
                  <Grid ColumnDefinitions="*,24,170" ColumnSpacing="8" Margin="2,2">
                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                      <TextBlock Text="{Binding Key}" Classes="mono" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding InvalidText}" Classes="caption error wrap" IsVisible="{Binding IsInvalid}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost valueReset" Command="{Binding ResetCommand}" IsVisible="{Binding CanReset}" ToolTip.Tip="{Binding ResetTip}">
                      <c:GlyphIcon Kind="Icon.Undo" IconSize="11" />
                    </Button>
                    <CheckBox Grid.Column="2" IsChecked="{Binding Flag}" IsVisible="{Binding IsFlag}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" ToolTip.Tip="{Binding Tip}" />
                    <TextBox Grid.Column="2" Classes="price" Classes.invalid="{Binding IsInvalid}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding !IsFlag}"
                             IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" KeyDown="OnValueKeyDown" ToolTip.Tip="{Binding Tip}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- The selected trader's stock -->
        <Border Grid.Column="1" Classes="panel" IsVisible="{Binding !IsSettingsOpen}">
          <DockPanel IsVisible="{Binding HasTrader}" Margin="14,12,14,8">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,10">
              <Border Grid.Column="0" Classes="typeTile hero" Classes.placed="{Binding IsPlacedTrader}" Classes.unknown="{Binding IsUnknownTrader}">
                <c:GlyphIcon Kind="{Binding TraderIconKey}" IconSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
                  <TextBlock x:Name="TraderTitleText" Text="{Binding TraderTitle}" Classes="h1" FontSize="20" VerticalAlignment="Center" />
                  <Border Classes="chip" VerticalAlignment="Center"><TextBlock Text="{Binding TraderCell}" Classes="mono" /></Border>
                  <Border Classes="chip" VerticalAlignment="Center"><TextBlock Text="{Binding TraderType}" /></Border>
                  <Border Classes="badge accent" IsVisible="{Binding IsPlacedTrader}"><TextBlock Text="{Tr Economy.Badge.Ready}" /></Border>
                  <Border Classes="badge warn" IsVisible="{Binding IsUnknownTrader}" ToolTip.Tip="{Tr Economy.UnknownTrader.Tip}"><TextBlock Text="{Tr Economy.UnknownTrader}" /></Border>
                </WrapPanel>
                <TextBlock Text="{Binding TraderCaption}" Classes="muted" />
              </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
              <WrapPanel Grid.Column="0" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                <Panel Width="240">
                  <TextBox x:Name="EconomySearch" Classes="search" Text="{Binding FilterText}" Watermark="{Tr Economy.Search}" ToolTip.Tip="{Tr Economy.Search.Tip}" />
                  <c:GlyphIcon Kind="Icon.Search" IconSize="15" Margin="11,0,0,0" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                </Panel>
                <ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" MinWidth="170" ToolTip.Tip="{Tr Economy.Category.Tip}" />
                <Button Classes="ghost" Content="{Tr Economy.PricesUp}" Command="{Binding ScalePricesCommand}" CommandParameter="1.1" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Tr Economy.PricesUp.Tip}" />
                <Button Classes="ghost" Content="{Tr Economy.PricesDown}" Command="{Binding ScalePricesCommand}" CommandParameter="0.9" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Tr Economy.PricesDown.Tip}" />
                <Button Classes="ghost" Content="{Tr Economy.OffSale}" Command="{Binding SetOnSaleCommand}" CommandParameter="false" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Tr Economy.OffSale.Tip}" />
                <Button Classes="ghost" Content="{Tr Economy.OnSale}" Command="{Binding SetOnSaleCommand}" CommandParameter="true" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Tr Economy.OnSale.Tip}" />
                <Button Classes="ghost" Content="{Tr Economy.ResetTrader}" Command="{Binding ResetTraderCommand}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Tr Economy.ResetTrader.Tip}" />
              </WrapPanel>
              <Button Grid.Column="1" x:Name="AddItemsButton" Classes="accent" VerticalAlignment="Top" Command="{Binding ToggleAddCommand}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Tr Economy.AddItems.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:GlyphIcon Kind="Icon.Plus" IconSize="14" />
                  <TextBlock Text="{Tr Economy.AddItems}" />
                </StackPanel>
              </Button>
            </Grid>

            <Panel>
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="3,42,*,110,112,112,92,92,62,72,64" ColumnSpacing="8" Margin="6,0,10,4">
                  <TextBlock Grid.Column="2" Text="{Tr Economy.Col.Item}" Classes="caption" />
                  <TextBlock Grid.Column="3" Text="{Tr Economy.Col.Category}" Classes="caption" />
                  <TextBlock Grid.Column="4" Text="{Tr Economy.Col.Price}" Classes="caption" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="{Tr Economy.Col.Sell}" Classes="caption" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="6" Text="{Tr Economy.Col.Fame}" Classes="caption" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="7" Text="{Tr Economy.Col.Delta}" Classes="caption" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="8" Text="{Tr Economy.Col.OnSale}" Classes="caption" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="9" Text="{Tr Economy.Col.AfterSale}" Classes="caption" HorizontalAlignment="Center" />
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Classes="caption wrap" Text="{Tr Economy.Note}" Margin="2,6,0,0" />

                <ListBox x:Name="EconomyItems" Classes="plain" ItemsSource="{Binding Items}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EconomyItemViewModel">
                      <Border Classes="itemRow" Classes.changed="{Binding IsChanged}" Classes.added="{Binding IsAdded}" Classes.unknown="{Binding IsUnknown}" Classes.off="{Binding IsOffSale}">
                        <Grid ColumnDefinitions="3,42,*,110,112,112,92,92,62,72,64" ColumnSpacing="8">
                          <Border Grid.Column="0" Classes="mark" />
                          <Border Grid.Column="1" Classes="thumb">
                            <Panel>
                              <c:GlyphIcon Kind="{Binding IconKey}" IconSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                              <c:ThumbnailImage Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="itemName" Text="{Binding Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <DockPanel>
                              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
                                <Border Classes="badge ok" Margin="0,0,2,0" IsVisible="{Binding IsAdded}"><TextBlock Text="{Tr Economy.Badge.Added}" /></Border>
                                <Border Classes="badge warn" Margin="0,0,2,0" IsVisible="{Binding IsUnknown}" ToolTip.Tip="{Tr Economy.Badge.Unknown.Tip}"><TextBlock Text="{Tr Economy.Badge.Unknown}" /></Border>
                                <Border Classes="badge" Margin="0,0,2,0" IsVisible="{Binding IsOffSale}"><TextBlock Text="{Tr Economy.Badge.OffSale}" /></Border>
                                <Border Classes="badge warn" Margin="0,0,2,0" IsVisible="{Binding IsLocked}"><TextBlock Text="{Tr Economy.Badge.Locked}" /></Border>
                                <Border Classes="badge warn" Margin="0,0,2,0" IsVisible="{Binding SellAboveBuy}"><TextBlock Text="{Tr Economy.Badge.SellAboveBuy}" /></Border>
                              </StackPanel>
                              <TextBlock Classes="caption" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <Run Text="{Binding Code}" />
                                <Run Text=" · " />
                                <Run Text="{Binding DefaultText}" />
                              </TextBlock>
                            </DockPanel>
                            <TextBlock Classes="caption error wrap" Text="{Binding InvalidText}" IsVisible="{Binding IsInvalid}" />
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding Category}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <!-- Each box is read when it is left or Enter is pressed (F111); its Reset is the glyph on its left. -->
                          <DockPanel Grid.Column="4" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Left" Classes="ghost valueReset" Command="{Binding ResetPurchaseCommand}" IsVisible="{Binding CanResetPurchase}" ToolTip.Tip="{Binding PurchaseResetTip}">
                              <c:GlyphIcon Kind="Icon.Undo" IconSize="10" />
                            </Button>
                            <TextBox x:Name="BuyBox" Classes="price" Text="{Binding PurchaseText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsEditable}" KeyDown="OnValueKeyDown" ToolTip.Tip="{Tr Economy.Price.Tip}" />
                          </DockPanel>
                          <DockPanel Grid.Column="5" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Left" Classes="ghost valueReset" Command="{Binding ResetSellCommand}" IsVisible="{Binding CanResetSell}" ToolTip.Tip="{Binding SellResetTip}">
                              <c:GlyphIcon Kind="Icon.Undo" IconSize="10" />
                            </Button>
                            <TextBox x:Name="SellBox" Classes="price" Text="{Binding SellText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsEditable}" KeyDown="OnValueKeyDown" ToolTip.Tip="{Tr Economy.Sell.Tip}" />
                          </DockPanel>
                          <DockPanel Grid.Column="6" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Left" Classes="ghost valueReset" Command="{Binding ResetFameCommand}" IsVisible="{Binding CanResetFame}" ToolTip.Tip="{Binding FameResetTip}">
                              <c:GlyphIcon Kind="Icon.Undo" IconSize="10" />
                            </Button>
                            <TextBox x:Name="FameBox" Classes="price" Text="{Binding FameText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsEditable}" KeyDown="OnValueKeyDown" ToolTip.Tip="{Tr Economy.Fame.Tip}" />
                          </DockPanel>
                          <DockPanel Grid.Column="7" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Left" Classes="ghost valueReset" Command="{Binding ResetDeltaCommand}" IsVisible="{Binding CanResetDelta}" ToolTip.Tip="{Binding DeltaResetTip}">
                              <c:GlyphIcon Kind="Icon.Undo" IconSize="10" />
                            </Button>
                            <TextBox x:Name="DeltaBox" Classes="price" Text="{Binding DeltaText, UpdateSourceTrigger=LostFocus}" Watermark="-1" IsEnabled="{Binding IsEditable}" KeyDown="OnValueKeyDown" ToolTip.Tip="{Tr Economy.Delta.Tip}" />
                          </DockPanel>
                          <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Classes="ghost valueReset" Command="{Binding ResetOnSaleCommand}" IsVisible="{Binding CanResetOnSale}" ToolTip.Tip="{Binding OnSaleResetTip}">
                              <c:GlyphIcon Kind="Icon.Undo" IconSize="10" />
                            </Button>
                            <CheckBox IsChecked="{Binding CanBePurchased}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" ToolTip.Tip="{Tr Economy.OnSaleBox.Tip}" />
                          </StackPanel>
                          <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Classes="ghost valueReset" Command="{Binding ResetAfterSaleCommand}" IsVisible="{Binding CanResetAfterSale}" ToolTip.Tip="{Binding AfterSaleResetTip}">
                              <c:GlyphIcon Kind="Icon.Undo" IconSize="10" />
                            </Button>
                            <CheckBox IsChecked="{Binding AfterSaleOnly}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" ToolTip.Tip="{Tr Economy.AfterSaleBox.Tip}" />
                          </StackPanel>
                          <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Classes="ghost square" Command="{Binding ResetCommand}" IsVisible="{Binding IsChanged}" IsEnabled="{Binding IsEditable}" ToolTip.Tip="{Tr Economy.ResetItem.Tip}">
                              <c:GlyphIcon Kind="Icon.Undo" IconSize="13" />
                            </Button>
                            <Button x:Name="RemoveItemButton" Classes="ghost square" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" ToolTip.Tip="{Tr Economy.Remove.Tip}">
                              <c:GlyphIcon Kind="Icon.Trash" IconSize="13" />
                            </Button>
                            <Button x:Name="PutBackButton" Classes="ghost square" Command="{Binding PutBackCommand}" IsVisible="{Binding CanPutBack}" ToolTip.Tip="{Tr Economy.PutBack.Tip}">
                              <c:GlyphIcon Kind="Icon.Plus" IconSize="13" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>

              <!-- Add items: a drawer over the list with any tradeable of the game, with its picture, ticked and added in one go -->
              <Border x:Name="AddPanel" Classes="dialog" Width="390" Padding="14,12" HorizontalAlignment="Right" IsVisible="{Binding IsAddOpen}">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Tr Economy.AddTitle}" Classes="h3" />
                      <TextBlock Text="{Binding TraderTitle}" Classes="mono accent" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost square" VerticalAlignment="Top" Command="{Binding ToggleAddCommand}" ToolTip.Tip="{Tr Economy.AddClose.Tip}">
                      <c:GlyphIcon Kind="Icon.Close" IconSize="13" />
                    </Button>
                  </Grid>
                  <Panel DockPanel.Dock="Top" Margin="0,10,0,8">
                    <TextBox x:Name="AddSearch" Classes="search" Text="{Binding AddFilterText}" Watermark="{Tr Economy.AddSearch}" ToolTip.Tip="{Tr Economy.AddSearch.Tip}" />
                    <c:GlyphIcon Kind="Icon.Search" IconSize="15" Margin="11,0,0,0" IsHitTestVisible="False"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                  </Panel>
                  <TextBlock DockPanel.Dock="Bottom" Classes="caption wrap" Text="{Tr Economy.AddNote}" Margin="0,8,0,0" />
                  <Button DockPanel.Dock="Bottom" x:Name="AddCheckedButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"
                          Command="{Binding AddCheckedCommand}" ToolTip.Tip="{Tr Economy.AddChecked.Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:GlyphIcon Kind="Icon.Plus" IconSize="14" />
                      <TextBlock Text="{Tr Economy.AddChecked}" />
                      <TextBlock Text="{Binding AddCheckedCount}" Classes="mono" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <ListBox x:Name="AddList" Classes="plain" ItemsSource="{Binding AddItems}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:EconomyPickItem">
                        <Grid ColumnDefinitions="Auto,42,*,Auto" ColumnSpacing="8" Margin="0,2">
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" ToolTip.Tip="{Tr Economy.AddPick.Tip}" />
                          <Border Grid.Column="1" Classes="thumb">
                            <Panel>
                              <c:GlyphIcon Kind="{Binding IconKey}" IconSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                              <c:ThumbnailImage Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Classes="caption" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="3" Text="{Binding PriceText}" Classes="mono" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
