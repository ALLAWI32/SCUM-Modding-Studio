<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScumStudio.App.ViewModels"
             xmlns:c="using:ScumStudio.App.Controls"
             xmlns:v="using:ScumStudio.App.Views.Pages"
             x:Class="ScumStudio.App.Views.Pages.ModulePageView"
             x:DataType="vm:ModulePageViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.chips">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,2,4,2" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Border.valueRow">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Border.valueRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    </Style>
    <Style Selector="Border.valueRow.pending">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Ellipse.edited">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- ===== Header ===== -->
    <Border DockPanel.Dock="Top" Classes="pageHeader">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Grid.Column="0" Classes="pageGlyph"><c:GlyphIcon Kind="{Binding IconKey}" IconSize="22" /></Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Classes="pageTitle" />
          <TextBlock Text="{Binding Subtitle}" Classes="muted" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="chip" VerticalAlignment="Center" ToolTip.Tip="{Binding SourceText}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GlyphIcon Kind="Icon.Pak" IconSize="13" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SourceText}" MaxWidth="280" TextTrimming="PrefixCharacterEllipsis" />
            </StackPanel>
          </Border>
          <Button Classes="ghost square" Command="{Binding UndoCommand}" ToolTip.Tip="{Tr Common.Undo.Tip}">
            <c:GlyphIcon Kind="Icon.Undo" IconSize="16" />
          </Button>
          <Button Classes="ghost square" Command="{Binding RedoCommand}" ToolTip.Tip="{Tr Common.Redo.Tip}">
            <c:GlyphIcon Kind="Icon.Redo" IconSize="16" />
          </Button>
          <Button Command="{Binding OpenLooseFolderPickerCommand}" ToolTip.Tip="{Tr Common.OpenLooseFolder.Tip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GlyphIcon Kind="Icon.Folder" IconSize="14" />
              <TextBlock Text="{Tr Common.OpenFolder}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Toolbar ===== -->
    <!-- Same three columns as the body below, so the search box always lines up with the list. -->
    <Grid x:Name="ModuleToolbar" DockPanel.Dock="Top" Margin="24,0,24,12" ColumnSpacing="12" IsVisible="{Binding HasCatalog}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="220" MaxWidth="300" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" MinWidth="240" MaxWidth="330" />
      </Grid.ColumnDefinitions>
      <Panel Grid.Column="0">
        <TextBox x:Name="SearchBox" Classes="search" Text="{Binding SearchText}" Watermark="{Tr Module.Filter}" ToolTip.Tip="{Tr Module.Filter.Tip}" />
        <c:GlyphIcon Kind="Icon.Search" IconSize="15" Margin="11,0,0,0" IsHitTestVisible="False"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
      </Panel>
      <ListBox Grid.Column="1" Grid.ColumnSpan="2" Classes="chips" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" VerticalAlignment="Center"
               ToolTip.Tip="{Tr Module.Chips.Tip}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ModuleFilter">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- ===== Body ===== -->
    <Panel Margin="24,0,24,20">

      <Border Classes="emptyState" IsVisible="{Binding ShowEmptyState}">
        <StackPanel Spacing="12">
          <Border Classes="iconTile" HorizontalAlignment="Center">
            <c:GlyphIcon Kind="Icon.Sliders" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Tr Module.Empty}" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Classes="muted wrap" TextAlignment="Center" MaxWidth="520"
                     Text="{Tr Module.Empty.Body}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Classes="accent" Content="{Tr Common.OpenSetup}" Command="{Binding OpenSetupCommand}" ToolTip.Tip="{Tr Common.OpenSetup.Tip}" />
            <Button Content="{Tr Common.OpenExtractedFolder}" Command="{Binding OpenLooseFolderPickerCommand}" ToolTip.Tip="{Tr Common.OpenLooseFolder.Tip}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="emptyState" IsVisible="{Binding IsLoading}">
        <StackPanel Spacing="12" Width="320">
          <TextBlock Text="{Tr Module.Loading}" Classes="h2" HorizontalAlignment="Center" />
          <ProgressBar IsIndeterminate="True" />
        </StackPanel>
      </Border>

      <!-- The list and the clone column give way first (down to their minimum), so the values keep their names on a small screen. -->
      <Grid x:Name="ModuleBody" ColumnSpacing="12" IsVisible="{Binding HasCatalog}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="220" MaxWidth="300" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" MinWidth="240" MaxWidth="330" />
        </Grid.ColumnDefinitions>

        <!-- List: inventory icons load for the rows on screen; right-click selects the row and opens the menu -->
        <Border Grid.Column="0" Classes="panel">
          <ListBox x:Name="ItemList" Classes="plain" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="4">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Tr Module.ViewIn3D}" Command="{Binding ViewIn3DCommand}" ToolTip.Tip="{Tr Module.ViewIn3D.Tip}">
                  <MenuItem.Icon><c:GlyphIcon Kind="Icon.Cube3d" IconSize="14" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Tr Module.CopySpawn}" Command="{Binding CopySpawnCommandCommand}" ToolTip.Tip="{Tr Module.CopySpawn.Tip}">
                  <MenuItem.Icon><c:GlyphIcon Kind="Icon.Copy" IconSize="14" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Tr Module.CloneEllipsis}" Command="{Binding CloneItemCommand}" ToolTip.Tip="{Tr Module.CloneMenu.Tip}">
                  <MenuItem.Icon><c:GlyphIcon Kind="Icon.Plus" IconSize="14" /></MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModuleItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Grid.Column="0" Width="64" Height="30" CornerRadius="{DynamicResource SmallCornerRadius}" Background="{DynamicResource Surface2Brush}" ClipToBounds="True">
                    <Panel>
                      <c:GlyphIcon Kind="{Binding IconKey}" IconSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                      <c:ThumbnailImage Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PackagePath}" />
                    <TextBlock Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="badge accent" IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Badge}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- Selected asset: header with the Values / 3D tabs, then the values editor or the orbit view -->
        <Border Grid.Column="1" Classes="panel">
          <DockPanel IsVisible="{Binding HasSelection}">
            <Border DockPanel.Dock="Top" Classes="panelHeader">
              <!-- The spawn chip shares the room with the name (2:1) instead of taking it all: the name vanished on a small screen. -->
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="2*" MinWidth="90" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" MaxWidth="256" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Classes="iconTile" Width="40" Height="40">
                  <c:GlyphIcon Kind="{Binding SelectedItem.IconKey, FallbackValue=Icon.Weapon}" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" ClipToBounds="True">
                  <!-- Name and caption share the row and trim: a long caption ran under the tabs and the spawn chip. -->
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="{Binding SelectedTitle}" Classes="h2" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    <TextBlock Grid.Column="1" Text="{Binding Caption}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Caption}" />
                  </Grid>
                  <TextBlock Text="{Binding SelectedItem.PackagePath, FallbackValue=''}" Classes="caption" TextTrimming="PrefixCharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="2" Classes="segmented">
                  <StackPanel Orientation="Horizontal">
                    <ToggleButton IsChecked="{Binding !ShowPreviewTab}" ToolTip.Tip="{Tr Module.ValuesTab.Tip}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <c:GlyphIcon Kind="Icon.Sliders" IconSize="13" />
                        <TextBlock Text="{Tr Module.Values}" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="PreviewTabButton" IsChecked="{Binding ShowPreviewTab}" ToolTip.Tip="{Tr Module.PreviewTab.Tip}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <c:GlyphIcon Kind="Icon.Cube3d" IconSize="13" />
                        <TextBlock Text="3D" />
                      </StackPanel>
                    </ToggleButton>
                  </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="chip" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip.Tip="{Tr Module.SpawnChip.Tip}">
                  <TextBlock Text="{Binding SpawnCommandText}" Classes="mono" TextTrimming="CharacterEllipsis" />
                </Border>
              </Grid>
            </Border>

            <Panel>
              <!-- Values tab -->
              <DockPanel IsVisible="{Binding !ShowPreviewTab}">
                <Grid DockPanel.Dock="Top" Margin="12,10,12,6" ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" MaxWidth="260" />
                    <ColumnDefinition Width="*" MinWidth="90" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="{Tr Module.Part.Tip}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ModulePart">
                        <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Description}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Panel Grid.Column="1">
                    <TextBox Classes="search" Text="{Binding ValueFilter}" Watermark="{Tr Module.ValueFilter}" ToolTip.Tip="{Tr Module.ValueFilter.Tip}" />
                    <c:GlyphIcon Kind="Icon.Search" IconSize="15" Margin="11,0,0,0" IsHitTestVisible="False"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                  </Panel>
                  <ToggleButton Grid.Column="2" IsChecked="{Binding KeyStatsOnly}" ToolTip.Tip="{Tr Module.KeyStats.Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:GlyphIcon Kind="Icon.Star" IconSize="14" />
                      <TextBlock Text="{Tr Module.KeyStats}" />
                    </StackPanel>
                  </ToggleButton>
                </Grid>

                <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StrokeSubtleBrush}">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="{Binding ValuesSummary}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="{Tr Module.Discard}" Command="{Binding DiscardChangesCommand}" ToolTip.Tip="{Tr Module.Discard.Tip}" />
                    <Button Grid.Column="2" Classes="accent" Command="{Binding ApplyChangesCommand}" ToolTip.Tip="{Tr Module.Apply.Tip}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:GlyphIcon Kind="Icon.Check" IconSize="14" />
                        <TextBlock Text="{Tr Module.Apply}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>

                <!-- Same star columns as the rows below (their width minus the 60 px action column and its gap), so they line up at any width. -->
                <Grid DockPanel.Dock="Top" Margin="22,4,80,2" ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="110" />
                    <ColumnDefinition Width="*" MinWidth="64" MaxWidth="120" />
                    <ColumnDefinition Width="*" MinWidth="100" MaxWidth="200" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Tr Module.Col.Value}" Classes="section" ToolTip.Tip="{Tr Module.Col.Value.Tip}" />
                  <TextBlock Grid.Column="1" Text="{Tr Module.Col.Stock}" Classes="section" ToolTip.Tip="{Tr Module.Col.Stock.Tip}" />
                  <TextBlock Grid.Column="2" Text="{Tr Module.Col.New}" Classes="section" ToolTip.Tip="{Tr Module.Col.New.Tip}" />
                </Grid>

                <Panel>
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingValues}" VerticalAlignment="Top" Margin="12,0" />
                  <ScrollViewer Margin="6,0,6,6" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TunableGroupViewModel">
                          <StackPanel Margin="0,6,0,2">
                            <TextBlock Text="{Binding Title}" Classes="h3" Margin="10,6,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TunableRowViewModel">
                                  <Border Classes="valueRow" Classes.pending="{Binding IsPending}">
                                    <Grid ColumnSpacing="10">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="110" />
                                        <ColumnDefinition Width="*" MinWidth="64" MaxWidth="120" />
                                        <ColumnDefinition Width="*" MinWidth="100" MaxWidth="200" />
                                        <ColumnDefinition Width="60" />
                                      </Grid.ColumnDefinitions>
                                      <!-- A dock, not a horizontal stack: a long name trims at its column instead of running under the stock value. -->
                                      <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                        <Ellipse Classes="edited" Width="7" Height="7" Margin="0,0,7,0" IsVisible="{Binding IsOverridden}" ToolTip.Tip="{Tr Module.Edited.Tip}" />
                                        <!-- A value the file does not store (a katana's MaxHealth): its parent class under the name, editable all the same. -->
                                        <StackPanel VerticalAlignment="Center">
                                          <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding PathText}" TextTrimming="CharacterEllipsis" />
                                          <TextBlock Text="{Binding InheritedNote}" IsVisible="{Binding IsInherited}" ToolTip.Tip="{Binding InheritedTip}" Classes="muted"
                                                     FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                      </DockPanel>
                                      <TextBlock Grid.Column="1" Text="{Binding StockDisplay}" Classes="muted mono" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                 ToolTip.Tip="{Binding StockTip}" />
                                      <Panel Grid.Column="2">
                                        <!-- The tip says what to type, with the reason first when the game cannot read the value. -->
                                        <TextBox Text="{Binding Value}" IsVisible="{Binding IsText}" IsReadOnly="{Binding IsReadOnly}" Classes="mono">
                                          <ToolTip.Tip>
                                            <StackPanel Spacing="2" MaxWidth="360">
                                              <TextBlock Text="{Binding Error}" Classes="error wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                              <TextBlock Text="{Tr Module.Col.New.Tip}" Classes="wrap" />
                                            </StackPanel>
                                          </ToolTip.Tip>
                                        </TextBox>
                                        <CheckBox IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBool}" IsEnabled="{Binding !IsReadOnly}" ToolTip.Tip="{Tr Module.BoolValue.Tip}" />
                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" IsVisible="{Binding IsEnum}" HorizontalAlignment="Stretch" ToolTip.Tip="{Tr Module.EnumValue.Tip}">
                                          <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                              <TextBlock Text="{Binding Converter={x:Static vm:TunableRowViewModel.ChoiceLabel}}" ToolTip.Tip="{Binding}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                          </ComboBox.ItemTemplate>
                                        </ComboBox>
                                      </Panel>
                                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                      <Button Classes="ghost square small" IsVisible="{Binding IsPart}" ToolTip.Tip="{Tr Module.ShowOnCar.Tip}"
                                              Command="{Binding $parent[UserControl].((vm:ModulePageViewModel)DataContext).ShowPartOnCarCommand}" CommandParameter="{Binding}">
                                        <c:GlyphIcon Kind="Icon.Cube3d" IconSize="13" />
                                      </Button>
                                      <Button Classes="ghost square small" ToolTip.Tip="{Tr Module.ResetRow.Tip}"
                                              Command="{Binding $parent[UserControl].((vm:ModulePageViewModel)DataContext).ResetRowCommand}" CommandParameter="{Binding}">
                                        <c:GlyphIcon Kind="Icon.Undo" IconSize="13" />
                                      </Button>
                                      </StackPanel>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Panel>
              </DockPanel>

              <!-- 3D tab: the asset's mesh (vehicles with their default attachments on their sockets) -->
              <Grid x:Name="PreviewBody" IsVisible="{Binding ShowPreviewTab}" ColumnDefinitions="*,0,0">
              <Border Margin="6" CornerRadius="{DynamicResource SmallCornerRadius}" ClipToBounds="True" Background="{DynamicResource ViewportBrush}">
                <Panel>
                  <c:ViewportGrid Background="{DynamicResource ViewportBrush}" AxisXBrush="{DynamicResource AxisXBrush}" AxisYBrush="{DynamicResource AxisYBrush}" IsVisible="{Binding !HasPreview}" />
                  <c:MeshPreview x:Name="ItemPreview" Model="{Binding Preview}" HighlightAttachment="{Binding HighlightAttachment}" IsVisible="{Binding HasPreview}"
                                 Tool="{Binding StudioTool}" GizmoMode="{Binding StudioGizmoMode}" PartOverrides="{Binding StudioPartOverrides}" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPreviewLoading}" VerticalAlignment="Top" Margin="8,6" />
                  <!-- The model's name (left) and the mouse hint (right) share the bottom line; the name trims instead of running under the hint. -->
                  <Grid VerticalAlignment="Bottom" Margin="8" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsHitTestVisible="False">
                    <Border Classes="hud" HorizontalAlignment="Left" IsVisible="{Binding PreviewText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{Binding PreviewText}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Border Grid.Column="1" Classes="hud" IsVisible="{Binding HasPreview}">
                      <TextBlock Text="{Tr Module.PreviewHint}" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </Grid>
                  <Border Classes="segmented" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" IsVisible="{Binding HasPreview}">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton x:Name="ItemPreviewSunButton" IsChecked="{Binding #ItemPreview.Light, Converter={x:Static c:PreviewLightConverter.IsSun}}" ToolTip.Tip="{Tr Preview.Sun.Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <c:GlyphIcon Kind="Icon.Sun" IconSize="13" VerticalAlignment="Center" />
                          <TextBlock Text="{Tr Preview.Sun}" VerticalAlignment="Center" />
                        </StackPanel>
                      </ToggleButton>
                      <ToggleButton x:Name="ItemPreviewScaleButton" IsChecked="{Binding #ItemPreview.ShowScale}" ToolTip.Tip="{Tr Preview.Scale.Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <c:GlyphIcon Kind="Icon.Ruler" IconSize="13" VerticalAlignment="Center" />
                          <TextBlock Text="{Tr Preview.Scale}" VerticalAlignment="Center" />
                        </StackPanel>
                      </ToggleButton>
                    </StackPanel>
                  </Border>
                  <!-- Vehicles studio: what the left mouse button does on the tab shown (turn, place a decal, move a part) -->
                  <Border x:Name="StudioToolHint" Classes="hud" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" MaxWidth="360" IsHitTestVisible="False"
                          IsVisible="{Binding ShowStudioToolHint}">
                    <TextBlock Text="{Binding StudioToolHint}" TextWrapping="Wrap" />
                  </Border>
                  <Border Classes="hud" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,30,8,8" MaxWidth="460" IsHitTestVisible="False" IsVisible="{Binding CloneSharesPaint}">
                    <TextBlock Text="{Tr Paint.CloneShared}" TextWrapping="Wrap" />
                  </Border>
                  <Border Classes="hud" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8" IsHitTestVisible="False"
                          IsVisible="{Binding #ItemPreview.SelectedPart, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding #ItemPreview.SelectedPart}" FontWeight="SemiBold" />
                      <TextBlock Text="{Tr Preview.PartHint}" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                  </Border>
                </Panel>
              </Border>

              <!-- Paint (vehicles, weapons): shown on the model as it is chosen; the splitter makes the panel wider or narrower -->
              <GridSplitter Grid.Column="1" x:Name="PaintSplitter" ResizeDirection="Columns" Background="Transparent" IsVisible="{Binding ShowStudioPanel}"
                            ToolTip.Tip="{Tr Common.Splitter.Tip}" />
              <Border Grid.Column="2" Margin="0,6,6,6" IsVisible="{Binding ShowStudioPanel}" Classes="panel">
                <DockPanel>
                  <!-- Vehicles studio tabs; a weapon keeps its materials only -->
                  <Border x:Name="StudioTabs" DockPanel.Dock="Top" Classes="segmented" Margin="12,10,12,0" HorizontalAlignment="Left" IsVisible="{Binding HasStudioTabs}">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton x:Name="StudioMaterialsTab" Click="OnStudioTabClick" IsChecked="{Binding IsStudioMaterials}" Content="{Tr Studio.Tab.Materials}" ToolTip.Tip="{Tr Studio.Tab.Materials.Tip}" />
                      <ToggleButton x:Name="StudioTexturesTab" Click="OnStudioTabClick" IsChecked="{Binding IsStudioTextures}" Content="{Tr Studio.Tab.Textures}" ToolTip.Tip="{Tr Studio.Tab.Textures.Tip}" />
                      <ToggleButton x:Name="StudioDecalsTab" Click="OnStudioTabClick" IsChecked="{Binding IsStudioDecals}" Content="{Tr Studio.Tab.Decals}" ToolTip.Tip="{Tr Studio.Tab.Decals.Tip}" />
                      <ToggleButton x:Name="StudioPartsTab" Click="OnStudioTabClick" IsChecked="{Binding IsStudioParts}" Content="{Tr Studio.Tab.Parts}" ToolTip.Tip="{Tr Studio.Tab.Parts.Tip}" />
                    </StackPanel>
                  </Border>
                  <StackPanel DockPanel.Dock="Top" Margin="12,10,12,4" Spacing="2" IsVisible="{Binding ShowMaterialsPanel}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Tr Paint.Title}" Classes="h2" />
                      <Button Grid.Column="1" x:Name="PaintAllOriginalButton" Classes="accent small" Content="{Tr Paint.AllOriginal}" Command="{Binding AllOriginalPaintCommand}"
                              VerticalAlignment="Center" ToolTip.Tip="{Tr Paint.AllOriginal.Tip}" />
                    </Grid>
                    <TextBlock Text="{Binding PaintCaption}" Classes="caption wrap" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                      <TextBlock Text="{Tr Paint.Together}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <ToggleSwitch x:Name="PaintTogetherSwitch" Grid.Column="1" IsChecked="{Binding PaintTogether}" OnContent="" OffContent="" MinWidth="0"
                                    ToolTip.Tip="{Tr Paint.Together.Tip}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasArmour}">
                      <TextBlock Text="{Tr Paint.Armour}" VerticalAlignment="Center" />
                      <ComboBox x:Name="ArmourPicker" Grid.Column="1" ItemsSource="{Binding ArmourChoices}" SelectedItem="{Binding Armour}" HorizontalAlignment="Stretch"
                                ToolTip.Tip="{Tr Paint.Armour.Tip}" />
                    </Grid>
                  </StackPanel>
                  <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StrokeSubtleBrush}" IsVisible="{Binding ShowMaterialsPanel}">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="caption wrap" Text="{Binding PaintNote}" />
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="{Tr Paint.Discard}" Command="{Binding DiscardPaintCommand}" ToolTip.Tip="{Tr Paint.Discard.Tip}" />
                        <Button x:Name="ApplyPaintButton" Classes="accent" Content="{Tr Paint.Apply}" Command="{Binding ApplyPaintCommand}" ToolTip.Tip="{Tr Paint.Apply.Tip}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Panel>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding ShowMaterialsPanel}">
                    <ItemsControl x:Name="PaintList" ItemsSource="{Binding Paints}" Margin="12,0,12,8">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaintMaterialViewModel">
                          <StackPanel Spacing="6" Margin="0,8,0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Tr Paint.Added}" Classes="caption wrap" IsVisible="{Binding IsArmour}" />
                            <TextBlock Text="{Tr Paint.Tint}" Classes="caption wrap" IsVisible="{Binding IsTint}" />
                            <CheckBox IsChecked="{Binding Plain}" IsVisible="{Binding IsArmour}" ToolTip.Tip="{Tr Paint.Plain.Tip}">
                              <TextBlock Text="{Tr Paint.Plain}" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding Plain}" IsVisible="{Binding IsTint}" ToolTip.Tip="{Tr Paint.Even.Tip}">
                              <TextBlock Text="{Tr Paint.Even}" TextWrapping="Wrap" />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ColorPicker Color="{Binding Colour}" IsAlphaEnabled="False" IsAlphaVisible="False" ToolTip.Tip="{Tr Paint.Colour.Tip}" />
                              <TextBlock Text="{Tr Paint.Colour}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSecond}">
                              <ColorPicker Color="{Binding Second}" IsAlphaEnabled="False" IsAlphaVisible="False" ToolTip.Tip="{Tr Paint.Second.Tip}" />
                              <TextBlock Text="{Tr Paint.Second}" VerticalAlignment="Center" />
                            </StackPanel>
                            <WrapPanel ItemSpacing="4" LineSpacing="4">
                              <Button Classes="ghost small" Content="{Tr Paint.Finish.Original}" Command="{Binding OriginalCommand}" ToolTip.Tip="{Tr Paint.Finish.Original.Tip}" />
                              <ItemsControl ItemsSource="{Binding Finishes}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:PaintFinish">
                                    <Button Classes="ghost small" Content="{Binding Label}" CommandParameter="{Binding}"
                                            Command="{Binding $parent[ItemsControl].((vm:PaintMaterialViewModel)DataContext).ApplyFinishCommand}"
                                            ToolTip.Tip="{Tr Paint.Finish.Tip}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </WrapPanel>
                            <Grid ColumnDefinitions="80,*,44" ColumnSpacing="6" IsVisible="{Binding HasMetal}">
                              <TextBlock Text="{Tr Paint.Metal}" Classes="caption" VerticalAlignment="Center" />
                              <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Metal}" SmallChange="0.05" LargeChange="0.1" ToolTip.Tip="{Tr Paint.Metal.Tip}" />
                              <TextBlock Grid.Column="2" Text="{Binding MetalText}" Classes="caption mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid ColumnDefinitions="80,*,44" ColumnSpacing="6" IsVisible="{Binding HasClearCoat}">
                              <TextBlock Text="{Tr Paint.ClearCoat}" Classes="caption" VerticalAlignment="Center" />
                              <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ClearCoat}" SmallChange="0.05" LargeChange="0.1" ToolTip.Tip="{Tr Paint.ClearCoat.Tip}" />
                              <TextBlock Grid.Column="2" Text="{Binding ClearCoatText}" Classes="caption mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <v:VehicleStudioMaterials />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <ScrollViewer x:Name="StudioTexturesPanel" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsStudioTextures}">
                    <v:VehicleStudioTextures />
                  </ScrollViewer>
                  <v:VehicleStudioDecals x:Name="StudioDecalsPanel" IsVisible="{Binding IsStudioDecals}" />
                  <ScrollViewer x:Name="StudioPartsPanel" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsStudioParts}">
                    <v:VehicleStudioParts />
                  </ScrollViewer>
                  </Panel>
                </DockPanel>
              </Border>
              </Grid>
            </Panel>
          </DockPanel>
        </Border>

        <!-- Clone + how-to -->
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:GlyphIcon Kind="Icon.Copy" IconSize="16" VerticalAlignment="Center" />
                  <TextBlock Text="{Tr Module.CloneTitle}" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox x:Name="CloneNameBox" Text="{Binding CloneName}" Watermark="{Tr Module.CloneName}" ToolTip.Tip="{Tr Module.CloneName.Tip}" />
                <TextBlock Text="{Binding CloneNameError}" Classes="error caption wrap" IsVisible="{Binding CloneNameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBox Text="{Binding CloneCaption}" Watermark="{Tr Module.CloneCaption}" ToolTip.Tip="{Tr Module.CloneCaption.Tip}" />
                <CheckBox Content="{Tr Module.CloneAttachments}" IsChecked="{Binding IncludeAttachments}" IsVisible="{Binding IsVehicleModule}" ToolTip.Tip="{Tr Module.CloneAttachments.Tip}" />
                <CheckBox Content="{Tr Module.ClonePresets}" IsChecked="{Binding IncludeSpawnPresets}" IsVisible="{Binding IsVehicleModule}" ToolTip.Tip="{Tr Module.ClonePresets.Tip}" />
                <TextBlock Text="{Binding ClonePreview}" Classes="caption wrap" />
                <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CreateCloneCommand}" ToolTip.Tip="{Tr Module.CreateClone.Tip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:GlyphIcon Kind="Icon.Plus" IconSize="14" />
                    <TextBlock Text="{Tr Module.CreateClone}" />
                  </StackPanel>
                </Button>
                <Button Classes="danger" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RemoveCloneCommand}"
                        IsVisible="{Binding CanRemoveClone}" Content="{Tr Module.RemoveClone}" ToolTip.Tip="{Tr Module.RemoveClone.Tip}" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:GlyphIcon Kind="Icon.Export" IconSize="16" VerticalAlignment="Center" />
                  <TextBlock Text="{Tr Module.IntoGame}" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="muted wrap" FontSize="12.5" LineHeight="19"
                           Text="{Tr Module.IntoGame.Step1}" />
                <TextBlock Classes="muted wrap" FontSize="12.5" LineHeight="19"
                           Text="{Tr Module.IntoGame.Step2}" />
                <TextBlock Classes="muted wrap" FontSize="12.5" LineHeight="19"
                           Text="{Tr Module.IntoGame.Step3}" />
                <Border Classes="inset" Padding="8,6">
                  <SelectableTextBlock Text="{Binding SpawnCommandText}" Classes="mono" />
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:GlyphIcon Kind="Icon.Info" IconSize="16" VerticalAlignment="Center" />
                  <TextBlock Text="{Tr Module.WhatCanChange}" Classes="h3" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="muted wrap" FontSize="12.5" LineHeight="19"
                           Text="{Tr Module.WhatCanChange.Body}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
