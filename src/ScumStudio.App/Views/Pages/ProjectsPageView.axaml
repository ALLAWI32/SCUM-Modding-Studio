<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScumStudio.App.ViewModels"
             xmlns:c="using:ScumStudio.App.Controls"
             x:Class="ScumStudio.App.Views.Pages.ProjectsPageView"
             x:DataType="vm:ProjectsPageViewModel">
  <UserControl.Styles>
    <!-- The open project's card. -->
    <Style Selector="Border.card.current">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <!-- One column at most 1100 wide, left-aligned like Settings: every block spans it, the cards split it in two. -->
    <Grid Margin="24,20,24,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="1100" />
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="PageContent" Spacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Title}" Classes="h1" />
            <TextBlock Text="{Binding Subtitle}" Classes="muted wrap" />
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding OpenCommand}" VerticalAlignment="Center" ToolTip.Tip="{Tr Projects.Open.Tip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GlyphIcon Kind="Icon.Folder" IconSize="14" />
              <TextBlock Text="{Tr Projects.OpenEllipsis}" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- Your projects: one click to open (owner: after an update he could not find his project among the files). -->
        <StackPanel Spacing="8">
          <TextBlock Text="{Tr Projects.Yours}" Classes="section" />
          <TextBlock Text="{Tr Projects.Yours.Empty}" Classes="caption wrap" IsVisible="{Binding !HasProjects}" />
          <!-- Two equal columns, the same as Current project / New project below (the -16 margin takes back the last gap). -->
          <ItemsControl x:Name="ProjectCards" ItemsSource="{Binding Projects}" IsVisible="{Binding HasProjects}" Margin="0,0,-16,-16">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectCardViewModel">
                <Border Classes="card" Classes.current="{Binding IsCurrent}" Margin="0,0,16,16">
                  <Grid RowDefinitions="*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Top">
                      <c:GlyphIcon Kind="Icon.Projects" IconSize="18" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                        <TextBlock Text="{Binding Details}" Classes="caption" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Path}" Classes="caption" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowFolder}" ToolTip.Tip="{Binding Path}" />
                      </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <Border Classes="badge accent" IsVisible="{Binding IsCurrent}" HorizontalAlignment="Left"><TextBlock Text="{Tr Projects.Card.Current}" /></Border>
                      <Button Grid.Column="1" Classes="ghost small" Content="{Tr Projects.ShowInFolder}" Command="{Binding ShowInFolderCommand}" CommandParameter="{Binding Path}"
                              ToolTip.Tip="{Tr Projects.ShowInFolder.Tip}" />
                      <Button Grid.Column="2" Classes="accent small" Content="{Tr Common.Open}" Command="{Binding OpenCommand}" CommandParameter="{Binding Path}"
                              IsVisible="{Binding !IsCurrent}" ToolTip.Tip="{Tr Projects.OpenRecent.Tip}" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Projects opened before whose folder is gone: one muted line each, never a card among the real ones. -->
          <ItemsControl x:Name="MissingProjects" ItemsSource="{Binding MissingProjects}" IsVisible="{Binding HasMissingProjects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MissingProjectRow">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <c:GlyphIcon Kind="Icon.Warning" IconSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                  <Button Grid.Column="2" Classes="ghost small" Content="{Tr Projects.RemoveMissing}" ToolTip.Tip="{Tr Projects.RemoveMissing.Tip}"
                          Command="{Binding $parent[UserControl].((vm:ProjectsPageViewModel)DataContext).RemoveMissingCommand}" CommandParameter="{Binding Path}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <!-- Current project: its manifest, or one click back to the last one. -->
          <Border Grid.Column="0" Classes="card" x:Name="CurrentCard">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="iconTile"><c:GlyphIcon Kind="Icon.Projects" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Tr Projects.Current}" Classes="h2" />
                  <TextBlock Text="{Binding Session.DisplayName}" Classes="caption" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost" Content="{Tr Common.Close}" Command="{Binding CloseCommand}" IsVisible="{Binding Session.HasProject}" VerticalAlignment="Center"
                        ToolTip.Tip="{Tr Projects.Close.Tip}" />
              </Grid>
              <StackPanel Spacing="12" IsVisible="{Binding !Session.HasProject}">
                <TextBlock Classes="muted wrap" Text="{Tr Projects.NoProject}" />
                <Button x:Name="OpenRecentButton" Classes="accent" HorizontalAlignment="Left" IsVisible="{Binding HasRecentProject}"
                        Command="{Binding OpenRecentCommand}" CommandParameter="{Binding RecentProject.Path, FallbackValue={x:Null}}" ToolTip.Tip="{Tr Projects.OpenNamed.Tip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:GlyphIcon Kind="Icon.Folder" IconSize="14" />
                    <TextBlock Text="{Binding OpenRecentText}" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding CurrentRows}" IsVisible="{Binding Session.HasProject}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PropertyRow">
                    <Grid ColumnDefinitions="140,*" ColumnSpacing="8" Margin="0,3">
                      <TextBlock Text="{Binding Name}" Classes="caption wrap" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Create -->
          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="iconTile"><c:GlyphIcon Kind="Icon.Plus" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Tr Projects.New}" Classes="h2" />
                  <TextBlock Text="{Tr Projects.New.Caption}" Classes="caption wrap" />
                </StackPanel>
              </Grid>
              <StackPanel>
                <TextBlock Text="{Tr Projects.Name}" Classes="label" />
                <TextBox Text="{Binding NewProjectName}" Watermark="MyMapMod" ToolTip.Tip="{Tr Projects.Name.Tip}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{Tr Projects.ParentFolder}" Classes="label" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding NewProjectFolder}" ToolTip.Tip="{Tr Projects.ParentFolder.Tip}" />
                  <Button Grid.Column="1" Content="{Tr Common.Browse}" Command="{Binding BrowseFolderCommand}" ToolTip.Tip="{Tr Common.BrowseFolder.Tip}" />
                </Grid>
              </StackPanel>
              <Button Classes="accent" HorizontalAlignment="Right" Command="{Binding CreateCommand}" ToolTip.Tip="{Tr Projects.Create.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:GlyphIcon Kind="Icon.Plus" IconSize="14" />
                  <TextBlock Text="{Tr Projects.Create}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Copies of the open project (Discord, salvador.garcia and pheidian): a new project from it, and named snapshots to go back to. -->
        <Border Classes="card" x:Name="VersionsCard" IsVisible="{Binding Session.HasProject}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="iconTile"><c:GlyphIcon Kind="Icon.History" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Tr Projects.Versions}" Classes="h2" />
                <TextBlock Text="{Tr Projects.Versions.Caption}" Classes="caption wrap" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="{Tr Projects.Copy.Name}" Classes="label" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="DuplicateNameBox" Text="{Binding DuplicateName}" ToolTip.Tip="{Tr Projects.Copy.Name.Tip}" />
                  <Button Grid.Column="1" x:Name="DuplicateButton" Command="{Binding DuplicateCommand}" ToolTip.Tip="{Tr Projects.Copy.Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:GlyphIcon Kind="Icon.Copy" IconSize="14" />
                      <TextBlock Text="{Tr Projects.Copy}" />
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock Text="{Tr Projects.Copy.Caption}" Classes="caption wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="{Tr Projects.Snapshot.Name}" Classes="label" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="SnapshotNameBox" Text="{Binding SnapshotName}" Watermark="{Tr Projects.Snapshot.Watermark}" ToolTip.Tip="{Tr Projects.Snapshot.Name.Tip}" />
                  <Button Grid.Column="1" x:Name="SaveSnapshotButton" Command="{Binding SaveSnapshotCommand}" ToolTip.Tip="{Tr Projects.Snapshot.Save.Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:GlyphIcon Kind="Icon.Plus" IconSize="14" />
                      <TextBlock Text="{Tr Projects.Snapshot.Save}" />
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock Text="{Tr Projects.Snapshot.Caption}" Classes="caption wrap" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Tr Projects.Snapshot.None}" Classes="caption wrap" IsVisible="{Binding !HasSnapshots}" />
            <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSnapshots}">
              <ItemsControl x:Name="SnapshotList" ItemsSource="{Binding Snapshots}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SnapshotRowViewModel">
                    <StackPanel Spacing="6" Margin="0,4">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <c:GlyphIcon Kind="Icon.History" IconSize="14" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Snapshot.Path}" />
                          <TextBlock Text="{Binding Details}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Snapshot.Path}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Classes="ghost small" Content="{Tr Projects.Snapshot.OpenAsNew}" Command="{Binding OpenAsNewCommand}" ToolTip.Tip="{Tr Projects.Snapshot.OpenAsNew.Tip}" />
                          <Button Classes="small" Content="{Tr Projects.Snapshot.Restore}" Command="{Binding RestoreCommand}" ToolTip.Tip="{Tr Projects.Snapshot.Restore.Tip}" />
                        </StackPanel>
                      </Grid>
                      <Border Classes="card" Padding="10,8" IsVisible="{Binding IsConfirming}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding ConfirmText}" Classes="wrap" VerticalAlignment="Center" FontSize="12.5" />
                          <Button Grid.Column="1" Classes="accent small" Content="{Tr Projects.Snapshot.Restore}" Command="{Binding ConfirmRestoreCommand}"
                                  VerticalAlignment="Center" ToolTip.Tip="{Tr Projects.Snapshot.Confirm.Tip}" />
                          <Button Grid.Column="2" Classes="ghost small" Content="{Tr Projects.Snapshot.Cancel}" Command="{Binding CancelRestoreCommand}"
                                  VerticalAlignment="Center" ToolTip.Tip="{Tr Projects.Snapshot.Cancel.Tip}" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- Export: only with a project open; without one, a single line says so. -->
        <StackPanel Spacing="8">
          <TextBlock Text="{Tr Projects.ExportSection}" Classes="section" />
          <TextBlock Text="{Binding ExportHint}" Classes="caption wrap" IsVisible="{Binding !Session.HasProject}" x:Name="ExportNeedsProject" />
          <StackPanel Spacing="16" IsVisible="{Binding Session.HasProject}">
            <Border Classes="card" x:Name="ExportCard">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Grid.Column="0" Classes="iconTile"><c:GlyphIcon Kind="Icon.Export" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Tr Projects.Build}" Classes="h2" />
                    <TextBlock Classes="caption wrap" Text="{Tr Projects.Build.Caption}" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="accent" VerticalAlignment="Center" Command="{Binding ExportCommand}" x:Name="ExportButton" ToolTip.Tip="{Tr Projects.Export.Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:GlyphIcon Kind="Icon.Export" IconSize="14" />
                      <TextBlock Text="{Tr Projects.Export}" />
                    </StackPanel>
                  </Button>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Tr Projects.ModName}" Classes="label" />
                    <TextBox Text="{Binding ExportModName}" Watermark="{Tr Projects.ProjectName}" ToolTip.Tip="{Tr Projects.ModName.Tip}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Tr Projects.OutputFolder}" Classes="label" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding ExportFolder}" ToolTip.Tip="{Tr Projects.OutputFolder.Tip}" />
                      <Button Grid.Column="1" Content="{Tr Common.Browse}" Command="{Binding BrowseExportFolderCommand}" ToolTip.Tip="{Tr Common.BrowseFolder.Tip}" />
                    </Grid>
                  </StackPanel>
                </Grid>

                <CheckBox IsChecked="{Binding ExportServer}" ToolTip.Tip="{Tr Projects.ExportServer.Tip}">
                  <TextBlock Text="{Tr Projects.ExportServer}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="ExportCraftablesCheck" IsChecked="{Binding ExportCraftables}" ToolTip.Tip="{Tr Projects.ExportCraftables.Tip}">
                  <TextBlock Text="{Tr Projects.ExportCraftables}" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Text="{Binding ExportHint}" Classes="caption wrap" x:Name="ExportHintText" />

                <StackPanel Spacing="8" IsVisible="{Binding HasExportResult}">
                  <Separator />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Tr Projects.LastExport}" Classes="h2" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="small" x:Name="OpenProblemListButton" Content="{Tr Projects.OpenProblemList}" Command="{Binding OpenProblemListCommand}"
                            IsVisible="{Binding ProblemListPath, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Tr Projects.OpenProblemList.Tip}" />
                    <Button Grid.Column="2" Classes="small" Content="{Tr Common.OpenFolder}" Command="{Binding OpenExportFolderCommand}" ToolTip.Tip="{Tr Projects.OpenExportFolder.Tip}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding ExportRows}" x:Name="ExportRowsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PropertyRow">
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="8" Margin="0,3">
                          <TextBlock Text="{Binding Name}" Classes="caption wrap" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="badge warn" HorizontalAlignment="Left">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasExportWarnings" />
                        <Binding Path="ProblemListPath" Converter="{x:Static ObjectConverters.IsNull}" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <TextBlock Text="{Tr Projects.Warnings}" />
                  </Border>
                  <Border Classes="badge error" HorizontalAlignment="Left" IsVisible="{Binding ProblemListPath, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Tr Projects.Row.ProblemList}" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding ExportWarnings}" IsVisible="{Binding HasExportWarnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Check my install (hexter_98, youngpiegus): what stands between the export and the game, in words. -->
            <Border Classes="card" x:Name="InstallCard">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Grid.Column="0" Classes="iconTile"><c:GlyphIcon Kind="Icon.Check" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Tr Install.Title}" Classes="h2" />
                    <TextBlock Text="{Tr Install.Caption}" Classes="caption wrap" />
                  </StackPanel>
                  <Button Grid.Column="2" x:Name="CheckInstallButton" VerticalAlignment="Center" Command="{Binding CheckInstallCommand}" ToolTip.Tip="{Tr Install.Check.Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:GlyphIcon Kind="Icon.Search" IconSize="14" />
                      <TextBlock Text="{Tr Install.Check}" />
                    </StackPanel>
                  </Button>
                </Grid>
                <ItemsControl x:Name="InstallRowsList" ItemsSource="{Binding InstallRows}" IsVisible="{Binding HasInstallRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstallRowViewModel">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,3">
                        <Border Classes="badge" Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarning}" Classes.error="{Binding IsProblem}"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Badge}" />
                        </Border>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" x:Name="ModsCard">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Grid.Column="0" Classes="iconTile"><c:GlyphIcon Kind="Icon.Download" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Tr Mods.Title}" Classes="h2" />
                    <TextBlock Text="{Tr Mods.Caption}" Classes="caption wrap" />
                  </StackPanel>
                  <Button Grid.Column="2" VerticalAlignment="Center" x:Name="ImportModButton" Command="{Binding ImportModCommand}" ToolTip.Tip="{Tr Mods.Import.Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:GlyphIcon Kind="Icon.Plus" IconSize="14" />
                      <TextBlock Text="{Tr Mods.Import}" />
                    </StackPanel>
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding ImportedMods}" IsVisible="{Binding HasImportedMods}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImportedModViewModel">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Summary}" Classes="caption" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="{Tr Mods.Carry}" IsChecked="{Binding IsCarried}" ToolTip.Tip="{Tr Mods.Carry.Tip}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="ghost small" Content="{Tr Mods.Remove}" Command="{Binding RemoveCommand}" ToolTip.Tip="{Tr Mods.Remove.Tip}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Game files: works without a project. -->
        <StackPanel Spacing="8">
          <TextBlock Text="{Tr Projects.GameFilesSection}" Classes="section" />
          <Border Classes="card" x:Name="DumpCard">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="iconTile"><c:GlyphIcon Kind="Icon.Download" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Tr Dump.Title}" Classes="h2" />
                <TextBlock Text="{Tr Projects.Dump.Caption}" Classes="caption wrap" />
              </StackPanel>
              <Button Grid.Column="2" VerticalAlignment="Center" Click="OnDumpClick" x:Name="DumpButton" ToolTip.Tip="{Tr Projects.Dump.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:GlyphIcon Kind="Icon.Download" IconSize="14" />
                  <TextBlock Text="{Tr Projects.DumpEllipsis}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
