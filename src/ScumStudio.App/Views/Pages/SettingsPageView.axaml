<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScumStudio.App.ViewModels"
             xmlns:c="using:ScumStudio.App.Controls"
             xmlns:conv="using:ScumStudio.App.Converters"
             xmlns:loc="using:ScumStudio.App.Localization"
             xmlns:cs="using:ScumStudio.Core.Settings"
             x:Class="ScumStudio.App.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
  <UserControl.DataTemplates>
    <!-- A quality preset (QualityPicker) by its name in the UI language, as the Map header's picker -->
    <DataTemplate x:DataType="cs:RenderQuality">
      <TextBlock>
        <TextBlock.Text>
          <MultiBinding Converter="{x:Static conv:RenderQualityTextConverter.Instance}">
            <Binding />
            <Binding Path="Language" Source="{x:Static loc:Loc.Instance}" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
    </DataTemplate>
  </UserControl.DataTemplates>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,20,24,24" Spacing="16" MaxWidth="920" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" Classes="h1" />
        <TextBlock Text="{Binding Subtitle}" Classes="muted" />
      </StackPanel>

      <!-- Appearance -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="iconTile"><c:GlyphIcon Kind="Icon.Palette" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Tr Settings.Appearance}" Classes="h2" />
              <TextBlock Classes="caption wrap" Text="{Binding AccentCaption}" />
            </StackPanel>
          </Grid>
          <ItemsControl x:Name="AccentList" ItemsSource="{Binding Accents}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AccentChoiceViewModel">
                <Button Classes="swatch" Classes.selected="{Binding IsSelected}" Margin="0,0,10,8"
                        Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Tip}">
                  <Border Width="24" Height="24" CornerRadius="6" Background="{Binding Hex, Converter={x:Static conv:HexBrushConverter.Instance}}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Tr Settings.AnyColour}" Classes="label" VerticalAlignment="Center" />
            <ColorPicker x:Name="AccentPicker" Color="{Binding CustomAccent}" IsAlphaEnabled="False" IsAlphaVisible="False"
                         ToolTip.Tip="{Tr Settings.AnyColour.Tip}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Tr Settings.Language}" Classes="label" />
            <ComboBox x:Name="LanguagePicker" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" MinWidth="220"
                      ToolTip.Tip="{Tr Settings.Language.Tip}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="loc:LanguageOption">
                  <TextBlock Text="{Binding NativeName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <CheckBox x:Name="ReopenLastProject" IsChecked="{Binding ReopenLastProject}" Content="{Tr Settings.ReopenLast}" ToolTip.Tip="{Tr Settings.ReopenLast.Tip}" />
          <CheckBox x:Name="ClearGrassUnderNew" IsChecked="{Binding ClearGrassUnderNew}" Content="{Tr Settings.ClearGrass}" ToolTip.Tip="{Tr Settings.ClearGrass.Tip}" />
          <!-- Owner: "when I delete it, everything of it must be deleted"; off, Delete takes the object alone as before -->
          <CheckBox x:Name="DeleteWithCompanionsBox" IsChecked="{Binding DeleteWithCompanions}" Content="{Tr Settings.DeleteWithCompanions}" ToolTip.Tip="{Tr Settings.DeleteWithCompanions.Tip}" />
          <!-- Owner: the toolbar button for this was pointless; the choice lives here now -->
          <StackPanel>
            <TextBlock Text="{Tr Map.Axes}" Classes="label" />
            <ComboBox x:Name="AxesPicker" ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" MinWidth="220" ToolTip.Tip="{Tr Map.Axes.Tip}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Graphics card (D03, AMD crashes): the GPU in use, what was turned off for it, Windows' GPU choice, the view switches -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="iconTile"><c:GlyphIcon Kind="Icon.Cube3d" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Tr Settings.Graphics}" Classes="h2" />
              <TextBlock Classes="caption wrap" Text="{Tr Settings.Graphics.Caption}" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="GpuInUseText" Text="{Binding GpuInUse}" Classes="wrap" ToolTip.Tip="{Tr Settings.Graphics.InUse.Tip}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasGpuWarning}">
            <c:GlyphIcon Kind="Icon.Warning" IconSize="13" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock x:Name="GpuWarningText" Text="{Binding GpuWarning}" Classes="warn caption wrap" MaxWidth="820" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="HighPerformanceGpuButton" Content="{Tr Settings.Graphics.HighPerformance}" Command="{Binding UseHighPerformanceGpuCommand}"
                    IsEnabled="{Binding CanUseHighPerformanceGpu}" ToolTip.Tip="{Tr Settings.Graphics.HighPerformance.Tip}" />
            <TextBlock Text="{Binding HighPerformanceStatus}" Classes="caption wrap" VerticalAlignment="Center" MaxWidth="560" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Tr Settings.Quality}" Classes="label" />
            <ComboBox x:Name="QualityPicker" ItemsSource="{Binding RenderQualities}" SelectedItem="{Binding RenderQuality}" MinWidth="220"
                      ToolTip.Tip="{Tr Settings.Quality.Tip}" />
          </StackPanel>
          <!-- Discord feature request: lighter view switches, apart from the quality presets -->
          <CheckBox x:Name="SpawnModelsBox" IsChecked="{Binding SpawnModels}" Content="{Tr Settings.SpawnModels}" ToolTip.Tip="{Tr Settings.SpawnModels.Tip}" />
          <CheckBox x:Name="AnimateWaterBox" IsChecked="{Binding AnimateWater}" Content="{Tr Settings.AnimateWater}" ToolTip.Tip="{Tr Settings.AnimateWater.Tip}" />
          <CheckBox x:Name="LightingBox" IsChecked="{Binding Lighting}" Content="{Tr Settings.Lighting}" ToolTip.Tip="{Tr Settings.Lighting.Tip}" />
          <CheckBox x:Name="AntiAliasedFoliageBox" IsChecked="{Binding AntiAliasedFoliage}" Content="{Tr Settings.AntiAliasedFoliage}" ToolTip.Tip="{Tr Settings.AntiAliasedFoliage.Tip}" />
          <!-- Smooth like the game (perf): far view in sectors and the adaptive 60 fps switch, next to the other graphics options -->
          <StackPanel>
            <TextBlock Text="{Tr Settings.RenderDistance}" Classes="label" />
            <ComboBox x:Name="RenderDistancePicker" ItemsSource="{Binding RenderDistances}" SelectedItem="{Binding RenderDistance}" MinWidth="220"
                      ToolTip.Tip="{Tr Settings.RenderDistance.Tip}" />
          </StackPanel>
          <CheckBox x:Name="SmoothFramesBox" IsChecked="{Binding SmoothFrames}" Content="{Tr Settings.Smooth}" ToolTip.Tip="{Tr Settings.Smooth.Tip}" />
          <!-- F15 (seviscache): how close the Map's camera still draws, for tight rooms (Ctrl+Shift+N on the Map) -->
          <StackPanel>
            <TextBlock Text="{Tr Settings.NearClip}" Classes="label" />
            <ComboBox x:Name="NearClipPicker" ItemsSource="{Binding NearClips}" SelectedItem="{Binding NearClip}" MinWidth="220"
                      ToolTip.Tip="{Tr Settings.NearClip.Tip}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Folders -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="iconTile"><c:GlyphIcon Kind="Icon.Folder" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="{Tr Settings.Folders}" Classes="h2" />
              <TextBlock Classes="caption wrap" Text="{Tr Settings.Folders.Caption}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="accent" Content="{Tr Settings.SaveFolders}" Command="{Binding SavePathsCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="{Tr Settings.SaveFolders.Tip}" />
          </Grid>

          <StackPanel>
            <TextBlock Text="{Tr Settings.GamePaks}" Classes="label" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding GamePaksFolder}" Watermark="...\steamapps\common\SCUM\SCUM\Content\Paks" ToolTip.Tip="{Tr Settings.GamePaks.Tip}" />
              <Button Grid.Column="1" Content="{Tr Common.Browse}" Command="{Binding BrowseCommand}" CommandParameter="game" ToolTip.Tip="{Tr Common.BrowseFolder.Tip}" />
            </Grid>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Tr Settings.ServerPaks}" Classes="label" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ServerPaksFolder}" Watermark="...\SCUMServer\SCUM\Content\Paks" ToolTip.Tip="{Tr Settings.ServerPaks.Tip}" />
              <Button Grid.Column="1" Content="{Tr Common.Browse}" Command="{Binding BrowseCommand}" CommandParameter="server" ToolTip.Tip="{Tr Common.BrowseFolder.Tip}" />
            </Grid>
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Tr Settings.ClientMods}" Classes="label" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ClientModsFolder}" Watermark="...\Paks\~mods" ToolTip.Tip="{Tr Settings.ClientMods.Tip}" />
                <Button Grid.Column="1" Content="{Tr Common.Browse}" Command="{Binding BrowseCommand}" CommandParameter="clientMods" ToolTip.Tip="{Tr Common.BrowseFolder.Tip}" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Tr Settings.ServerMods}" Classes="label" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ServerModsFolder}" Watermark="...\Paks\~mods" ToolTip.Tip="{Tr Settings.ServerMods.Tip}" />
                <Button Grid.Column="1" Content="{Tr Common.Browse}" Command="{Binding BrowseCommand}" CommandParameter="serverMods" ToolTip.Tip="{Tr Common.BrowseFolder.Tip}" />
              </Grid>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Key -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Grid.Column="0" Classes="iconTile" VerticalAlignment="Top"><c:GlyphIcon Kind="Icon.Key" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Tr Settings.AesKey}" Classes="h2" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="badge" Classes.ok="{Binding HasKey}"><TextBlock x:Name="KeyStatus" Text="{Binding KeyStatus}" /></Border>
            </StackPanel>
            <TextBlock Classes="caption wrap" Text="{Binding KeyProtection}" />
            <TextBlock Classes="caption wrap" Text="{Tr Settings.AesKey.Caption}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
            <Button Content="{Tr Settings.ChangeInSetup}" Command="{Binding OpenSetupCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="{Tr Settings.ChangeInSetup.Tip}" />
            <Button x:Name="ForgetKeyButton" Classes="danger" Content="{Tr Settings.ForgetKey}" Command="{Binding ForgetKeyCommand}"
                    IsEnabled="{Binding HasKey}" HorizontalAlignment="Stretch" ToolTip.Tip="{Tr Settings.ForgetKey.Tip}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- AI control -->
      <Border x:Name="AiControlCard" Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="iconTile" VerticalAlignment="Top"><c:GlyphIcon Kind="Icon.Ai" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{Tr Settings.AiControl}" Classes="h2" />
              <TextBlock Classes="caption wrap" Text="{Tr Settings.AiControl.Caption}" />
            </StackPanel>
            <ToggleSwitch x:Name="McpToggle" Grid.Column="2" IsChecked="{Binding McpEnabled}" OnContent="{Tr Common.On}" OffContent="{Tr Common.Off}" VerticalAlignment="Top"
                          ToolTip.Tip="{Tr Settings.McpToggle.Tip}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="badge" Classes.ok="{Binding McpRunning}"><TextBlock x:Name="McpStatus" Text="{Binding McpStatus}" /></Border>
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Tr Settings.Port}" Classes="label" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding McpPort}" Width="110" ToolTip.Tip="{Tr Settings.Port.Tip}" />
                <Button Content="{Tr Common.Apply}" Command="{Binding SaveMcpPortCommand}" ToolTip.Tip="{Tr Settings.ApplyPort.Tip}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Tr Settings.Token}" Classes="label" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="badge" VerticalAlignment="Center"><TextBlock x:Name="McpToken" Text="{Binding McpTokenMasked}" Classes="mono" /></Border>
                <Button Command="{Binding CopyMcpTokenCommand}" ToolTip.Tip="{Tr Settings.CopyToken.Tip}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><c:GlyphIcon Kind="Icon.Copy" IconSize="14" /><TextBlock Text="{Tr Common.Copy}" /></StackPanel>
                </Button>
                <Button Content="{Tr Settings.NewToken}" Command="{Binding NewMcpTokenCommand}" ToolTip.Tip="{Tr Settings.NewToken.Tip}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock Text="{Tr Settings.ConnectClient}" Classes="label" />
            <WrapPanel>
              <Button x:Name="CopyClaudeCode" Classes="accent" Margin="0,0,8,8" Command="{Binding CopyClaudeCodeCommandCommand}" ToolTip.Tip="{Tr Settings.CopyClaudeCode.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:GlyphIcon Kind="Icon.Copy" IconSize="14" /><TextBlock Text="{Tr Settings.CopyClaudeCode}" /></StackPanel>
              </Button>
              <Button Margin="0,0,8,8" Command="{Binding CopyClaudeDesktopConfigCommand}" ToolTip.Tip="{Tr Settings.CopyClaudeDesktop.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:GlyphIcon Kind="Icon.Copy" IconSize="14" /><TextBlock Text="{Tr Settings.CopyClaudeDesktop}" /></StackPanel>
              </Button>
              <Button x:Name="InstallSkill" Margin="0,0,8,8" Command="{Binding InstallClaudeSkillCommand}"
                      ToolTip.Tip="{Tr Settings.InstallSkill.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:GlyphIcon Kind="Icon.Download" IconSize="14" /><TextBlock Text="{Tr Settings.InstallSkill}" /></StackPanel>
              </Button>
            </WrapPanel>
            <SelectableTextBlock Text="{Binding McpCommandPreview}" Classes="mono" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>

          <TextBlock x:Name="McpActivity" Classes="caption wrap" Text="{Binding McpActivity}" IsVisible="{Binding HasMcpActivity}" />
          <TextBlock Classes="caption wrap" Text="{Tr Settings.AiControl.Safety}" />
        </StackPanel>
      </Border>

      <!-- Prefabs: the saved selections' library -->
      <Border x:Name="PrefabsCard" Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Grid.Column="0" Classes="iconTile" VerticalAlignment="Top"><c:GlyphIcon Kind="Icon.Layers" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Tr Settings.Prefabs}" Classes="h2" />
            <TextBlock Text="{Tr Settings.Prefabs.Caption}" Classes="caption wrap" />
            <TextBlock Text="{Tr Settings.Prefabs.Folder}" Classes="label" Margin="0,4,0,0" />
            <SelectableTextBlock Text="{Binding PrefabsFolder}" Classes="mono" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="OpenPrefabsFolderButton" Content="{Tr Common.OpenFolder}" Command="{Binding OpenPrefabsFolderCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="{Tr Settings.Prefabs.OpenFolder.Tip}" />
            <Button x:Name="SettingsImportPrefabButton" Content="{Tr Map.Prefabs.Import}" Command="{Binding ImportPrefabCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="{Tr Settings.Prefabs.Import.Tip}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Map toolbar: what the Map header shows (owner: "show only what I want"); the settings button at the header's end has the same switches -->
      <Border x:Name="ToolbarCard" Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="iconTile" VerticalAlignment="Top"><c:GlyphIcon Kind="Icon.Sliders" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{Tr Settings.Toolbar}" Classes="h2" ToolTip.Tip="{Tr Settings.Toolbar.Tip}" />
              <TextBlock Text="{Tr Settings.Toolbar.Hint}" Classes="caption wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button x:Name="SettingsToolbarShowAllButton" Content="{Tr Map.Toolbar.ShowAll}" Command="{Binding Toolbar.ShowAllCommand}" ToolTip.Tip="{Tr Map.Toolbar.ShowAll.Tip}" />
              <Button x:Name="SettingsToolbarResetButton" Content="{Tr Map.Toolbar.Reset}" Command="{Binding Toolbar.ResetDefaultsCommand}" ToolTip.Tip="{Tr Map.Toolbar.Reset.Tip}" />
            </StackPanel>
          </Grid>
          <ItemsControl x:Name="SettingsToolbarSwitches" ItemsSource="{Binding Toolbar.Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="16" LineSpacing="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MapToolbarItem">
                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsShown}" ToolTip.Tip="{Binding Tip}" MinWidth="190" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- About -->
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Grid.Column="0" Classes="iconTile" VerticalAlignment="Top"><c:GlyphIcon Kind="Icon.Info" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Tr Settings.About}" Classes="h2" />
            <TextBlock Text="{Tr Settings.About.MadeBy}" FontWeight="SemiBold" />
            <TextBlock Text="{Tr Settings.About.Body}" Classes="wrap" />
            <TextBlock Text="{Binding Version}" Classes="muted" ToolTip.Tip="{Binding BuildVersion}" />
            <SelectableTextBlock Text="{Binding DataFolderText}" Classes="mono" Foreground="{DynamicResource TextMutedBrush}" />
            <WrapPanel Margin="0,4,0,0">
              <Button x:Name="ProjectPageButton" Margin="0,0,8,0" Command="{Binding OpenProjectPageCommand}" ToolTip.Tip="{Tr Settings.About.Page.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:GlyphIcon Kind="Icon.Info" IconSize="14" /><TextBlock Text="{Tr Settings.About.Page}" /></StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
