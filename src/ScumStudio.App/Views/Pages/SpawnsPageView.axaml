<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScumStudio.App.ViewModels"
             xmlns:c="using:ScumStudio.App.Controls"
             x:Class="ScumStudio.App.Views.Pages.SpawnsPageView"
             x:DataType="vm:SpawnsPageViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.value">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.value.pending">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.spawnRow Slider">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,-16,0,0" />
    </Style>
    <Style Selector="Border.spawnRow">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
    </Style>
    <Style Selector="Border.spawnRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
    </Style>
    <Style Selector="Border.spawnRow.pending">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- One slider over stored values; the stored value is never rounded, the range widens to hold it. -->
    <DataTemplate DataType="vm:SpawnSliderViewModel">
      <Border Classes="spawnRow" Classes.pending="{Binding IsPending}" ToolTip.Tip="{Binding Tip}">
        <Grid ColumnDefinitions="190,*,110,Auto" ColumnSpacing="10">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="170" />
            <c:GlyphIcon Kind="Icon.Warning" IconSize="12" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsOutOfRange}"
                         ToolTip.Tip="{Tr Spawns.OutOfRange.Tip}" VerticalAlignment="Center" />
          </StackPanel>
          <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" ToolTip.Tip="{Binding Tip}"
                  SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="value" Classes.pending="{Binding IsPending}" Text="{Binding ValueText}" />
          <Button Grid.Column="3" Classes="ghost square small" ToolTip.Tip="{Tr Module.ResetRow.Tip}" Command="{Binding ResetCommand}" VerticalAlignment="Center">
            <c:GlyphIcon Kind="Icon.Undo" IconSize="13" />
          </Button>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- From / to pair, optionally with Empty / Half / Full. -->
    <DataTemplate DataType="vm:SpawnRangeViewModel">
      <StackPanel Spacing="2" Margin="0,4" ToolTip.Tip="{Binding Tip}">
        <Grid ColumnDefinitions="*,Auto" Margin="10,2,10,0">
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasQuickButtons}">
            <Button Classes="ghost small" Content="{Tr Spawns.Empty}" Command="{Binding SetBothCommand}" CommandParameter="0" ToolTip.Tip="{Tr Spawns.Empty.Tip}" />
            <Button Classes="ghost small" Content="{Tr Spawns.Half}" Command="{Binding SetBothCommand}" CommandParameter="0.5" ToolTip.Tip="{Tr Spawns.Half.Tip}" />
            <Button Classes="ghost small" Content="{Tr Spawns.Full}" Command="{Binding SetBothCommand}" CommandParameter="1" ToolTip.Tip="{Tr Spawns.Full.Tip}" />
          </StackPanel>
        </Grid>
        <ContentControl Content="{Binding From}" Margin="12,0,0,0" />
        <ContentControl Content="{Binding To}" Margin="12,0,0,0" />
      </StackPanel>
    </DataTemplate>

    <!-- A ServerSettings.ini value: switch or slider; -1 ("the game decides") is its own switch where the key has one. -->
    <DataTemplate DataType="vm:ServerSettingViewModel">
      <Border Classes="spawnRow" Classes.pending="{Binding IsPending}" ToolTip.Tip="{Binding Tip}">
        <Panel>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsToggle}">
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Flag}" OnContent="" OffContent="" VerticalAlignment="Center" ToolTip.Tip="{Binding Tip}" />
          </Grid>
          <Grid ColumnDefinitions="190,*,110,Auto" ColumnSpacing="10" IsVisible="{Binding IsSlider}">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="170" />
              <c:GlyphIcon Kind="Icon.Warning" IconSize="12" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsOutOfRange}"
                           ToolTip.Tip="{Tr Spawns.OutOfRange.Tip}" VerticalAlignment="Center" />
            </StackPanel>
            <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" ToolTip.Tip="{Binding Tip}"
                    SmallChange="{Binding Step}" LargeChange="{Binding Step}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                    IsEnabled="{Binding CanSlide}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="value" Classes.pending="{Binding IsPending}" Text="{Binding ValueText}" />
            <CheckBox Grid.Column="3" Content="{Tr Spawns.GameDefault}" IsChecked="{Binding IsGameDefault}" IsVisible="{Binding HasGameDefault}"
                      ToolTip.Tip="{Tr Spawns.GameDefault.Tip}" VerticalAlignment="Center" />
          </Grid>
        </Panel>
      </Border>
    </DataTemplate>

    <!-- A note inside a card; a warning only while its condition holds. -->
    <DataTemplate DataType="vm:SpawnNoteViewModel">
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,4" IsVisible="{Binding IsShown}">
        <c:GlyphIcon Kind="Icon.Warning" IconSize="13" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsWarning}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <c:GlyphIcon Kind="Icon.Info" IconSize="13" IsVisible="{Binding !IsWarning}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock Text="{Binding Text}" Classes="caption wrap" Classes.warn="{Binding IsWarning}" MaxWidth="760" />
      </StackPanel>
    </DataTemplate>

    <!-- A chance list row: the list's header (shared-asset badge, back to the game's weights) or one type with its chances. -->
    <DataTemplate DataType="vm:SpawnWeightRowViewModel">
      <Panel>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="4,10,4,2" IsVisible="{Binding IsHeader}" ToolTip.Tip="{Binding Tip}">
          <StackPanel Spacing="1">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsShared}" VerticalAlignment="Center">
            <TextBlock Text="{Binding SharedText}" Classes="warn" />
          </Border>
          <Button Grid.Column="2" Classes="ghost square small" ToolTip.Tip="{Tr Module.ResetRow.Tip}" Command="{Binding ResetCommand}" VerticalAlignment="Center">
            <c:GlyphIcon Kind="Icon.Undo" IconSize="13" />
          </Button>
        </Grid>
        <Border Classes="spawnRow" Classes.pending="{Binding IsPending}" IsVisible="{Binding IsEntry}" ToolTip.Tip="{Binding Tip}">
          <Grid ColumnDefinitions="190,*,70,70" ColumnSpacing="10">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding TypeGroup}" Classes="caption" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{Tr Spawns.Chance.InList.Tip}"
                    SmallChange="1" LargeChange="5" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="value" Classes.pending="{Binding IsPending}" Text="{Binding PercentText}" ToolTip.Tip="{Tr Spawns.Chance.InList.Tip}" />
            <TextBlock Grid.Column="3" Classes="value" Text="{Binding OverallText}" ToolTip.Tip="{Tr Spawns.Chance.Overall.Tip}" />
          </Grid>
        </Border>
      </Panel>
    </DataTemplate>

    <!-- A card of rows. -->
    <DataTemplate DataType="vm:SpawnCard">
      <Border Classes="card" Margin="0,0,0,12">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="iconTile" Width="36" Height="36">
              <c:GlyphIcon Kind="{Binding IconKey}" IconSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" Classes="h2" />
              <TextBlock Text="{Binding Caption}" Classes="caption wrap" IsVisible="{Binding HasCaption}" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Rows}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>

    <!-- ===== Header: the categories, pending count, Discard / Save ===== -->
    <Border DockPanel.Dock="Top" Classes="pageHeader">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Grid.Column="0" Classes="pageGlyph"><c:GlyphIcon Kind="{Binding IconKey}" IconSize="22" /></Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Classes="pageTitle" />
          <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="segmented">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="VehiclesTab" IsChecked="{Binding IsVehiclesTab}" ToolTip.Tip="{Tr Spawns.Category.Vehicles.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:GlyphIcon Kind="Icon.Vehicle" IconSize="13" />
                  <TextBlock Text="{Tr Spawns.Category.Vehicles}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ZombiesTab" IsChecked="{Binding IsZombiesTab}" ToolTip.Tip="{Tr Spawns.Category.Zombies.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:GlyphIcon Kind="Icon.Warning" IconSize="13" />
                  <TextBlock Text="{Tr Spawns.Category.Zombies}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="NpcsTab" IsChecked="{Binding IsNpcsTab}" ToolTip.Tip="{Tr Spawns.Category.Npcs.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:GlyphIcon Kind="Icon.Weapon" IconSize="13" />
                  <TextBlock Text="{Tr Spawns.Category.Npcs}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="AnimalsTab" IsChecked="{Binding IsAnimalsTab}" ToolTip.Tip="{Tr Spawns.Category.Animals.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:GlyphIcon Kind="Icon.Tree" IconSize="13" />
                  <TextBlock Text="{Tr Spawns.Category.Animals}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="PlayersTab" IsChecked="{Binding IsPlayersTab}" ToolTip.Tip="{Tr Spawns.Category.Players.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:GlyphIcon Kind="Icon.Pin" IconSize="13" />
                  <TextBlock Text="{Tr Spawns.Category.Players}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ServerTab" IsChecked="{Binding IsServerTab}" ToolTip.Tip="{Tr Spawns.Category.Server.Tip}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:GlyphIcon Kind="Icon.Server" IconSize="13" />
                  <TextBlock Text="{Tr Spawns.Category.Server}" />
                </StackPanel>
              </ToggleButton>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding PendingText}" IsVisible="{Binding HasPending}" Classes="caption" VerticalAlignment="Center" Margin="6,0,0,0" />
          <Button Classes="ghost" Content="{Tr Spawns.Discard}" Command="{Binding DiscardCommand}" ToolTip.Tip="{Tr Spawns.Discard.Tip}" />
          <Button x:Name="ApplyButton" Classes="accent" Command="{Binding ApplyCommand}" ToolTip.Tip="{Tr Spawns.Apply.Tip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GlyphIcon Kind="Icon.Check" IconSize="14" />
              <TextBlock Text="{Tr Spawns.Apply}" />
            </StackPanel>
          </Button>
          <!-- Owner 2026-10-17: each page as its own mod (this page's saved changes only) -->
          <Button x:Name="PageExportButton" Command="{Binding PageExport.ExportCommand}" ToolTip.Tip="{Tr Export.Module.Button.Tip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GlyphIcon Kind="Icon.Download" IconSize="14" />
              <TextBlock Text="{Tr Export.Module.Button}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- A moved chance list is shared by other places: the save waits for a yes. -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="24,0,24,10" IsVisible="{Binding IsConfirmingShared}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
        <c:GlyphIcon Kind="Icon.Warning" IconSize="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding SharedConfirmText}" Classes="wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="ghost" Content="{Tr Spawns.Shared.Cancel}" Command="{Binding CancelSharedCommand}" ToolTip.Tip="{Tr Spawns.Shared.Cancel.Tip}" />
        <Button Grid.Column="3" x:Name="ConfirmSharedButton" Classes="accent" Content="{Tr Spawns.Shared.SaveAnyway}" Command="{Binding ConfirmApplyCommand}" ToolTip.Tip="{Tr Spawns.Shared.SaveAnyway.Tip}" />
      </Grid>
    </Border>

    <!-- ===== Body ===== -->
    <Panel Margin="24,0,24,20">

      <!-- No game files yet (vehicles, zones and biomes come from them). -->
      <Border Classes="emptyState">
        <Border.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="ShowList" />
            <Binding Path="!HasCatalog" />
          </MultiBinding>
        </Border.IsVisible>
        <StackPanel Spacing="12">
          <Border Classes="iconTile" HorizontalAlignment="Center">
            <c:GlyphIcon Kind="Icon.Pin" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Tr Module.Empty}" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Classes="muted wrap" TextAlignment="Center" MaxWidth="520" Text="{Tr Spawns.Empty.Body}" />
          <Button Classes="accent" HorizontalAlignment="Center" Content="{Tr Common.OpenSetup}" Command="{Binding OpenSetupCommand}" ToolTip.Tip="{Tr Common.OpenSetup.Tip}" />
        </StackPanel>
      </Border>

      <!-- Vehicles / Zombies / NPCs / Animals: the island map with the area (left), what spawns there (right). -->
      <Grid ColumnDefinitions="*,640" ColumnSpacing="12">
        <Grid.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="ShowList" />
            <Binding Path="HasCatalog" />
          </MultiBinding>
        </Grid.IsVisible>
        <Border Grid.Column="0" x:Name="MapPane" Classes="panel" ClipToBounds="True">
          <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="8,8,8,4" ItemSpacing="6" LineSpacing="6">
              <Border Classes="segmented">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="SelectTool" IsChecked="{Binding IsSelectTool}" ToolTip.Tip="{Tr Spawns.Map.Tool.Select.Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <c:GlyphIcon Kind="Icon.Cursor" IconSize="12" />
                      <TextBlock Text="{Tr Spawns.Map.Tool.Select}" />
                    </StackPanel>
                  </ToggleButton>
                  <ToggleButton IsChecked="{Binding IsPanTool}" Content="{Tr Spawns.Map.Tool.Pan}" ToolTip.Tip="{Tr Spawns.Map.Tool.Pan.Tip}" />
                  <ToggleButton IsChecked="{Binding IsSectorTool}" Content="{Tr Spawns.Map.Tool.Sector}" ToolTip.Tip="{Tr Spawns.Map.Tool.Sector.Tip}" />
                  <ToggleButton IsChecked="{Binding IsRectangleTool}" Content="{Tr Spawns.Map.Tool.Rectangle}" ToolTip.Tip="{Tr Spawns.Map.Tool.Rectangle.Tip}" />
                  <ToggleButton IsChecked="{Binding IsPolygonTool}" Content="{Tr Spawns.Map.Tool.Polygon}" ToolTip.Tip="{Tr Spawns.Map.Tool.Polygon.Tip}" />
                  <ToggleButton x:Name="PlaceTool" IsChecked="{Binding IsPlaceTool}" ToolTip.Tip="{Tr Spawns.Map.Tool.Place.Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <c:GlyphIcon Kind="Icon.Plus" IconSize="12" />
                      <TextBlock Text="{Tr Spawns.Map.Tool.Place}" />
                    </StackPanel>
                  </ToggleButton>
                </StackPanel>
              </Border>
              <Button x:Name="FitButton" Classes="ghost" Content="{Tr Spawns.Map.Fit}" ToolTip.Tip="{Tr Spawns.Map.Fit.Tip}" Click="OnFitClick" />
              <Button Classes="ghost" Content="{Tr Spawns.Map.Picture.Import}" Command="{Binding ImportPictureCommand}" ToolTip.Tip="{Tr Spawns.Map.Picture.Import.Tip}" />
              <Button Classes="ghost" Content="{Tr Spawns.Map.Picture.Clear}" Command="{Binding ClearPictureCommand}" IsVisible="{Binding HasImportedPicture}" ToolTip.Tip="{Tr Spawns.Map.Picture.Clear.Tip}" />
            </WrapPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding MapSourceText}" Classes="caption" Margin="10,2,10,6" TextTrimming="CharacterEllipsis" />
            <Panel>
              <c:SpawnMap x:Name="SpawnMap" Picture="{Binding MapPicture}" Markers="{Binding Markers}" ShownLayers="{Binding ShownLayers}" Tool="{Binding MapTool}"
                          Area="{Binding Area, Mode=TwoWay}" HighlightedIds="{Binding Highlighted}" PlaceCommand="{Binding PlaceAtCommand}"
                          SelectedId="{Binding SelectedMarkerId, Mode=TwoWay}" MoveCommand="{Binding MovePlaceCommand}" TurnCommand="{Binding TurnPlaceCommand}"
                          DeleteCommand="{Binding DeletePlaceCommand}" ToolTip.Tip="{Tr Spawns.Map.Tip}" />
              <!-- The world point under the mouse (owner: "show coordinates"). -->
              <Border Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False"
                      IsVisible="{Binding #SpawnMap.CursorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock x:Name="CursorText" Text="{Binding #SpawnMap.CursorText}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11" />
              </Border>
            </Panel>
          </DockPanel>
        </Border>

        <Border Grid.Column="1" Classes="panel">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12,14,16" Spacing="10">

              <!-- Place NPCs (owner: NPC spawning is hard to follow): who, how many posts, then a click on the map. No weight list. -->
              <Border x:Name="NpcWizard" Classes="card" IsVisible="{Binding IsNpcsTab}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Tr Spawns.NpcWizard.Title}" Classes="h2" />
                  <TextBlock Text="{Tr Spawns.NpcWizard.Hint}" Classes="caption wrap" />
                  <TextBlock Text="{Tr Spawns.NpcWizard.Step1}" FontWeight="SemiBold" />
                  <ComboBox x:Name="NpcKindBox" ItemsSource="{Binding NpcKinds}" SelectedItem="{Binding SelectedNpcKind}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding !IsLoadingNpcKinds}" PlaceholderText="{Tr Spawns.NpcWizard.Loading}" ToolTip.Tip="{Tr Spawns.NpcWizard.Kind.Tip}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:NpcKindOption">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Title}" FontSize="12" />
                          <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox x:Name="NpcOwnCopyBox" Content="{Tr Spawns.NpcWizard.OwnCopy}" IsChecked="{Binding NpcOwnCopy}" ToolTip.Tip="{Tr Spawns.NpcWizard.OwnCopy.Tip}" />
                  <ComboBox x:Name="NpcCharacterBox" ItemsSource="{Binding NpcCharacters}" SelectedItem="{Binding SelectedNpcCharacter}" HorizontalAlignment="Stretch"
                            IsVisible="{Binding NpcOwnCopy}" ToolTip.Tip="{Tr Spawns.NpcWizard.Character.Tip}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:NpcCharacterOption">
                        <TextBlock Text="{Binding Title}" FontSize="12" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Tr Spawns.NpcWizard.Step2}" FontWeight="SemiBold" />
                  <ComboBox x:Name="NpcPostsBox" ItemsSource="{Binding NpcPostChoices}" SelectedItem="{Binding NpcPosts}" HorizontalAlignment="Stretch" ToolTip.Tip="{Tr Spawns.NpcWizard.Posts.Tip}" />
                  <TextBlock Text="{Tr Spawns.NpcWizard.Step3}" FontWeight="SemiBold" />
                  <TextBlock x:Name="NpcSummaryText" Text="{Binding NpcSummary}" Classes="caption wrap" IsVisible="{Binding HasNpcKind}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button x:Name="PickNpcPlaceButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding PickNpcPlaceCommand}" IsVisible="{Binding !IsNpcPlacing}" ToolTip.Tip="{Tr Spawns.NpcWizard.Pick.Tip}">
                      <TextBlock Text="{Tr Spawns.NpcWizard.Pick}" />
                    </Button>
                    <TextBlock x:Name="NpcWaitingText" Text="{Tr Spawns.NpcWizard.Waiting}" Classes="wrap" VerticalAlignment="Center" IsVisible="{Binding IsNpcPlacing}" />
                    <Button Grid.Column="1" x:Name="CancelNpcPlaceButton" Classes="ghost" Content="{Tr Spawns.NpcWizard.Cancel}"
                            Command="{Binding CancelNpcPlaceCommand}" IsVisible="{Binding IsNpcPlacing}" ToolTip.Tip="{Tr Spawns.NpcWizard.Cancel.Tip}" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- The picked place (owner: "full control of each spawn place"): where it is, what it spawns, move, turn, remove, Map page. -->
              <Border x:Name="PointCard" Classes="card" IsVisible="{Binding HasPoint}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Classes="iconTile" Width="34" Height="34">
                      <c:GlyphIcon Kind="{Binding Point.IconKey, FallbackValue='Icon.Pin'}" IconSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Point.KindText, FallbackValue=''}" Classes="h2" />
                      <SelectableTextBlock x:Name="PointName" Text="{Binding Point.Name, FallbackValue=''}" Classes="caption" ToolTip.Tip="{Tr Spawns.Point.Name.Tip}" />
                    </StackPanel>
                    <Button x:Name="ShowOnMapButton" Grid.Column="2" Classes="accent small" Command="{Binding ShowOnMapCommand}" VerticalAlignment="Center" ToolTip.Tip="{Tr Spawns.Point.ShowOnMap.Tip}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <c:GlyphIcon Kind="Icon.Map" IconSize="12" />
                        <TextBlock Text="{Tr Spawns.Point.ShowOnMap}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <SelectableTextBlock x:Name="PointWhere" Text="{Binding Point.CoordinatesText, FallbackValue=''}" Classes="caption" FontFamily="{DynamicResource MonoFontFamily}" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding Point.HasChoices, FallbackValue=False}">
                    <TextBlock Text="{Tr Spawns.Point.Spawns}" VerticalAlignment="Center" />
                    <ComboBox x:Name="PointSetting" Grid.Column="1" ItemsSource="{Binding Point.Choices, FallbackValue={x:Null}}" SelectedItem="{Binding Point.Setting, FallbackValue={x:Null}}"
                              HorizontalAlignment="Stretch" ToolTip.Tip="{Tr Spawns.Point.Spawns.Tip}" />
                  </Grid>
                  <TextBlock Classes="caption wrap" Text="{Tr Spawns.Point.FromZone}" IsVisible="{Binding Point.SpawnsFromZone, FallbackValue=False}" />
                  <TextBlock x:Name="PointSubZones" Classes="caption" TextWrapping="Wrap" Text="{Binding Point.SubZonesText, FallbackValue=''}" IsVisible="{Binding Point.HasSubZones, FallbackValue=False}" />
                  <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="2">
                    <TextBlock Text="{Tr Spawns.Point.X}" Classes="caption" />
                    <TextBlock Grid.Column="1" Text="{Tr Spawns.Point.Y}" Classes="caption" />
                    <TextBlock Grid.Column="2" Text="{Tr Spawns.Point.Z}" Classes="caption" />
                    <TextBlock Grid.Column="3" Text="{Tr Spawns.Point.Yaw}" Classes="caption" />
                    <TextBox x:Name="PointX" Grid.Row="1" Text="{Binding Point.XText, FallbackValue=''}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip.Tip="{Tr Spawns.Point.X.Tip}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ApplyPointCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBox x:Name="PointY" Grid.Row="1" Grid.Column="1" Text="{Binding Point.YText, FallbackValue=''}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip.Tip="{Tr Spawns.Point.Y.Tip}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ApplyPointCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBox x:Name="PointZ" Grid.Row="1" Grid.Column="2" Text="{Binding Point.ZText, FallbackValue=''}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip.Tip="{Tr Spawns.Point.Z.Tip}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ApplyPointCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBox x:Name="PointYaw" Grid.Row="1" Grid.Column="3" Text="{Binding Point.YawText, FallbackValue=''}" FontFamily="{DynamicResource MonoFontFamily}" ToolTip.Tip="{Tr Spawns.Point.Yaw.Tip}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ApplyPointCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                  </Grid>
                  <TextBlock Classes="warn caption wrap" Text="{Binding Point.Error, FallbackValue=''}" IsVisible="{Binding Point.HasError, FallbackValue=False}" />
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button x:Name="ApplyPointButton" Classes="ghost small" Content="{Tr Spawns.Point.Apply}" Command="{Binding ApplyPointCommand}" ToolTip.Tip="{Tr Spawns.Point.Apply.Tip}" />
                    <Button x:Name="GroundPointButton" Classes="ghost small" Content="{Tr Spawns.Point.Ground}" Command="{Binding GroundPointCommand}"
                            IsVisible="{Binding !Point.IsIndoor, FallbackValue=False}" ToolTip.Tip="{Tr Spawns.Point.Ground.Tip}" />
                    <Button x:Name="ZoomPointButton" Classes="ghost small" Content="{Tr Spawns.Point.Zoom}" Command="{Binding ZoomToPointCommand}" ToolTip.Tip="{Tr Spawns.Point.Zoom.Tip}" />
                    <Button x:Name="DeletePointButton" Classes="ghost small" Command="{Binding DeletePointCommand}" ToolTip.Tip="{Tr Spawns.Point.Delete.Tip}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <c:GlyphIcon Kind="Icon.Trash" IconSize="12" />
                        <TextBlock Text="{Tr Spawns.Point.Delete}" />
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                  <CheckBox x:Name="SnapToGround" Content="{Tr Spawns.Point.Snap}" IsChecked="{Binding SnapToGround}" ToolTip.Tip="{Tr Spawns.Point.Snap.Tip}" />
                  <TextBlock Classes="caption wrap" Text="{Tr Spawns.Point.Indoor}" IsVisible="{Binding Point.IsIndoor, FallbackValue=False}" />
                  <TextBlock Classes="caption wrap" Text="{Tr Spawns.Point.Keys}" />
                </StackPanel>
              </Border>

              <!-- The area: its places of the category, picked to change, remove or give their own settings. -->
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="{Tr Spawns.Area.Title}" Classes="h2" />
                      <TextBlock x:Name="AreaText" Text="{Binding AreaText}" Classes="caption wrap" />
                    </StackPanel>
                    <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsSearchingArea}" Width="80" VerticalAlignment="Center" />
                  </Grid>
                  <ListBox x:Name="AreaList" Classes="plain" ItemsSource="{Binding AreaPlaces}" SelectedItem="{Binding SelectedPlace}" Height="220"
                           IsVisible="{Binding HasAreaPlaces}" ToolTip.Tip="{Tr Spawns.Area.List.Tip}">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SpawnAreaPlaceItem">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" ToolTip.Tip="{Binding Tip}">
                          <CheckBox IsChecked="{Binding IsChecked}" ToolTip.Tip="{Tr Spawns.Area.Check.Tip}" VerticalAlignment="Center" />
                          <c:GlyphIcon Grid.Column="1" Kind="{Binding IconKey}" IconSize="14" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Setting}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding KindText}" Classes="caption" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding HasAreaPlaces}">
                    <Button Classes="ghost small" Content="{Tr Spawns.Area.CheckAll}" Command="{Binding CheckAllCommand}" ToolTip.Tip="{Tr Spawns.Area.CheckAll.Tip}" />
                    <Button x:Name="RemovePlaces" Classes="ghost small" Command="{Binding RemovePlacesCommand}" ToolTip.Tip="{Tr Spawns.Place.Remove.Tip}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <c:GlyphIcon Kind="Icon.Trash" IconSize="12" />
                        <TextBlock Text="{Tr Spawns.Place.Remove}" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="OwnCopy" Classes="ghost small" Content="{Tr Spawns.Zone.OwnCopy}" Command="{Binding OwnCopyCommand}" IsVisible="{Binding CanOwnCopy}" ToolTip.Tip="{Tr Spawns.Zone.OwnCopy.Tip}" />
                  </WrapPanel>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding NewKinds}" SelectedItem="{Binding NewKindOption}" MinWidth="150" ToolTip.Tip="{Tr Spawns.Place.Kind.Tip}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpawnKindOption">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SettingChoices}" SelectedItem="{Binding ChosenSetting}" HorizontalAlignment="Stretch" ToolTip.Tip="{Tr Spawns.Place.Setting.Tip}" />
                    <Button Grid.Column="2" Classes="ghost small" Content="{Tr Spawns.Place.SetSetting}" Command="{Binding SetSettingCommand}" IsVisible="{Binding HasAreaPlaces}" ToolTip.Tip="{Tr Spawns.Place.SetSetting.Tip}" />
                  </Grid>
                  <TextBlock Classes="caption wrap" Text="{Tr Spawns.Place.New.Tip}" />
                </StackPanel>
              </Border>

              <!-- Under-ground check (seviscache: "spawners below the terrain"). -->
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="{Tr Spawns.Ground.Check}" Classes="h2" />
                      <TextBlock Text="{Binding GroundText}" Classes="caption wrap" IsVisible="{Binding GroundText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Button x:Name="CheckGround" Grid.Column="1" Classes="ghost" Content="{Tr Spawns.Ground.Check}" Command="{Binding CheckGroundCommand}" ToolTip.Tip="{Tr Spawns.Ground.Check.Tip}" VerticalAlignment="Center" />
                  </Grid>
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCheckingGround}" />
                  <ListBox x:Name="GroundList" Classes="plain" ItemsSource="{Binding GroundFindings}" Height="160" IsVisible="{Binding HasGroundFindings}">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SpawnGroundItem">
                        <Grid ColumnDefinitions="Auto,*,70,Auto" ColumnSpacing="8">
                          <CheckBox IsChecked="{Binding IsChecked}" ToolTip.Tip="{Tr Spawns.Ground.Fix.Tip}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding KindText}" Classes="caption" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Classes="value" Text="{Binding DepthText}" ToolTip.Tip="{Tr Spawns.Ground.Depth.Tip}" />
                          <Button Grid.Column="3" Classes="ghost small" Content="{Tr Spawns.Ground.GoTo}" ToolTip.Tip="{Tr Spawns.Ground.GoTo.Tip}"
                                  Command="{Binding $parent[UserControl].((vm:SpawnsPageViewModel)DataContext).GoToCommand, FallbackValue={x:Null}}" CommandParameter="{Binding}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding HasGroundFindings}">
                    <Button Classes="ghost small" Content="{Tr Spawns.Ground.Fix}" Command="{Binding FixGroundCommand}" ToolTip.Tip="{Tr Spawns.Ground.Fix.Tip}" />
                    <Button x:Name="FixAllGround" Classes="accent small" Content="{Tr Spawns.Ground.FixAll}" Command="{Binding FixAllGroundCommand}" ToolTip.Tip="{Tr Spawns.Ground.FixAll.Tip}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- The settings, presets and biomes: the list, then the selected one's values and types. -->
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Tr Spawns.Entries.Title}" Classes="h2" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Tr Spawns.Loading}" Classes="caption" IsVisible="{Binding IsLoadingEntries}" VerticalAlignment="Center" />
                  </Grid>
                  <Panel>
                    <TextBox x:Name="SpawnSearch" Classes="search" Text="{Binding FilterText}" Watermark="{Tr Module.Filter}" ToolTip.Tip="{Tr Spawns.Filter.Tip}" />
                    <c:GlyphIcon Kind="Icon.Search" IconSize="15" Margin="11,0,0,0" IsHitTestVisible="False"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                  </Panel>
                  <ListBox x:Name="SpawnList" Classes="plain" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" Height="200">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SpawnEntry">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" ToolTip.Tip="{Binding PackagePath}">
                          <Border Width="30" Height="30" CornerRadius="{DynamicResource SmallCornerRadius}" Background="{DynamicResource Surface2Brush}">
                            <c:GlyphIcon Kind="{Binding IconKey}" IconSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Group}" Classes="caption" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
              <StackPanel Spacing="4" IsVisible="{Binding HasSelection}">
                <TextBlock Text="{Binding SelectedEntry.Name, FallbackValue=''}" Classes="h1" FontSize="20" />
                <TextBlock Text="{Binding SelectedEntry.Group, FallbackValue=''}" Classes="muted" Margin="0,0,0,10" />
                <TextBlock x:Name="DetailNote" Text="{Binding DetailNote}" Classes="muted wrap" IsVisible="{Binding HasDetailNote}" Margin="0,0,0,10" />
                <ItemsControl x:Name="DetailCards" ItemsSource="{Binding DetailCards}" />

                <!-- The types the zone or biome picks from: grouped, searchable, with a 3D preview of the selected one. -->
                <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding HasTypes}">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Classes="iconTile" Width="36" Height="36">
                        <c:GlyphIcon Kind="Icon.List" IconSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Tr Spawns.Types.Title}" Classes="h2" />
                        <TextBlock Text="{Tr Spawns.Types.Caption}" Classes="caption wrap" />
                      </StackPanel>
                    </Grid>
                    <Panel>
                      <TextBox x:Name="TypeSearch" Classes="search" Text="{Binding TypeFilter}" Watermark="{Tr Spawns.Types.Search}" ToolTip.Tip="{Tr Spawns.Types.Search.Tip}" />
                      <c:GlyphIcon Kind="Icon.Search" IconSize="15" Margin="11,0,0,0" IsHitTestVisible="False"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                    </Panel>
                    <ListBox x:Name="TypeList" Classes="plain" ItemsSource="{Binding TypeRows}" SelectedItem="{Binding SelectedType}" Height="380">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                    </ListBox>
                    <Border CornerRadius="{DynamicResource SmallCornerRadius}" ClipToBounds="True" Background="{DynamicResource ViewportBrush}"
                            Height="300" ToolTip.Tip="{Tr Spawns.Types.Preview.Tip}">
                      <Panel>
                        <c:ViewportGrid Background="{DynamicResource ViewportBrush}" AxisXBrush="{DynamicResource AxisXBrush}" AxisYBrush="{DynamicResource AxisYBrush}" IsVisible="{Binding !HasTypePreview}" />
                        <c:MeshPreview x:Name="TypePreview" Model="{Binding TypePreview}" IsVisible="{Binding HasTypePreview}" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTypePreviewLoading}" VerticalAlignment="Top" Margin="8,6" />
                        <Border Classes="hud" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" IsHitTestVisible="False">
                          <TextBlock Text="{Tr Spawns.Types.Preview}" />
                        </Border>
                        <Border Classes="hud" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" IsHitTestVisible="False"
                                IsVisible="{Binding TypePreviewText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <TextBlock Text="{Binding TypePreviewText}" TextWrapping="Wrap" />
                        </Border>
                      </Panel>
                    </Border>
                  </StackPanel>
                </Border>
                <TextBlock Classes="caption wrap" Text="{Tr Spawns.ExportNote}" Margin="2,4,0,0" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- Players: what the game allows for a first spawn, and the server's respawn rules. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsPlayersTab}">
        <StackPanel Spacing="10" MaxWidth="960" HorizontalAlignment="Left">
          <Border Classes="chip" HorizontalAlignment="Left" ToolTip.Tip="{Tr Spawns.ServerFile.Tip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GlyphIcon Kind="Icon.File" IconSize="13" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ServerFileText}" TextTrimming="PrefixCharacterEllipsis" MaxWidth="760" />
            </StackPanel>
          </Border>
          <ItemsControl x:Name="PlayerCards" ItemsSource="{Binding PlayerCards}" />
        </StackPanel>
      </ScrollViewer>

      <!-- Server settings. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsServerTab}">
        <StackPanel Spacing="10" MaxWidth="960" HorizontalAlignment="Left">
          <Border Classes="chip" HorizontalAlignment="Left" ToolTip.Tip="{Tr Spawns.ServerFile.Tip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:GlyphIcon Kind="Icon.File" IconSize="13" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ServerFileText}" TextTrimming="PrefixCharacterEllipsis" MaxWidth="760" />
            </StackPanel>
          </Border>
          <TextBlock Classes="caption wrap" Text="{Tr Spawns.ServerNote}" IsVisible="{Binding HasServerFile}" />
          <Border Classes="emptyState" IsVisible="{Binding !HasServerFile}">
            <StackPanel Spacing="12">
              <TextBlock Text="{Tr Spawns.NoServer}" Classes="h2" HorizontalAlignment="Center" />
              <TextBlock Classes="muted wrap" TextAlignment="Center" MaxWidth="560" Text="{Tr Spawns.NoServer.Body}" />
              <Button Classes="accent" HorizontalAlignment="Center" Content="{Tr Common.OpenSetup}" Command="{Binding OpenSetupCommand}" ToolTip.Tip="{Tr Common.OpenSetup.Tip}" />
            </StackPanel>
          </Border>
          <ItemsControl x:Name="ServerCards" ItemsSource="{Binding ServerCards}" />
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
