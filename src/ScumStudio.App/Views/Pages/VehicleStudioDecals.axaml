<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScumStudio.App.ViewModels"
             xmlns:c="using:ScumStudio.App.Controls"
             x:Class="ScumStudio.App.Views.Pages.VehicleStudioDecals"
             x:DataType="vm:ModulePageViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="12,8,12,4">
      <TextBlock Text="{Tr Studio.Decals.Title}" FontWeight="SemiBold" />
      <TextBlock Text="{Tr Studio.Decals.Caption}" Classes="caption wrap" />
      <ListBox x:Name="DecalCategoryList" Classes="chips" ItemsSource="{Binding DecalCategories}" SelectedItem="{Binding DecalCategory}"
               ToolTip.Tip="{Tr Studio.Decals.Design.Tip}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DecalCategoryItem">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer MaxHeight="228" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="DecalDesignGrid" ItemsSource="{Binding DecalDesigns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DecalDesignItem">
              <Button Classes="ghost" Padding="4" ToolTip.Tip="{Tr Studio.Decals.Design.Tip}" CommandParameter="{Binding}"
                      Command="{Binding $parent[UserControl].((vm:ModulePageViewModel)DataContext).ArmDecalCommand}">
                <StackPanel Spacing="2" Width="64">
                  <Image Source="{Binding Thumbnail}" Width="56" Height="56" Stretch="Uniform" />
                  <TextBlock Text="{Binding Name}" Classes="caption" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button Classes="ghost" Command="{Binding AddStickerCommand}" ToolTip.Tip="{Tr Studio.Decals.AddSticker.Tip}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:GlyphIcon Kind="Icon.Image" IconSize="15" />
          <TextBlock Text="{Tr Studio.Decals.AddSticker}" />
        </StackPanel>
      </Button>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StrokeSubtleBrush}">
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
        <Button Classes="ghost" Command="{Binding UndoDecalCommand}" IsEnabled="{Binding CanUndoDecal}" ToolTip.Tip="{Tr Studio.Decals.Undo.Tip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:GlyphIcon Kind="Icon.Undo" IconSize="14" />
            <TextBlock Text="{Tr Studio.Decals.Undo}" />
          </StackPanel>
        </Button>
        <Button x:Name="ApplyDecalsButton" Classes="accent" Command="{Binding ApplyDecalsCommand}" IsEnabled="{Binding HasDecals}" Content="{Tr Studio.Decals.Apply}"
                ToolTip.Tip="{Tr Studio.Decals.Apply.Tip}" />
      </StackPanel>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="6" Margin="12,4,12,8">
        <TextBlock Text="{Tr Studio.Decals.Empty}" Classes="caption wrap" IsVisible="{Binding !HasDecals}" />
        <ListBox x:Name="DecalLayerList" Classes="plain" ItemsSource="{Binding DecalLayers}" SelectedItem="{Binding SelectedDecal}"
                 IsVisible="{Binding HasDecals}" ToolTip.Tip="{Tr Studio.Decals.Caption}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DecalLayerViewModel">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasDecals}">
          <Button Classes="ghost small" Command="{Binding MoveDecalUpCommand}" ToolTip.Tip="{Tr Studio.Decals.Up.Tip}">
            <c:GlyphIcon Kind="Icon.ChevronDown" IconSize="14" RenderTransform="rotate(180deg)" />
          </Button>
          <Button Classes="ghost small" Command="{Binding MoveDecalDownCommand}" ToolTip.Tip="{Tr Studio.Decals.Down.Tip}">
            <c:GlyphIcon Kind="Icon.ChevronDown" IconSize="14" />
          </Button>
          <Button Classes="ghost small" Command="{Binding DuplicateDecalCommand}" ToolTip.Tip="{Tr Studio.Decals.Duplicate.Tip}">
            <c:GlyphIcon Kind="Icon.Copy" IconSize="14" />
          </Button>
          <Button Classes="ghost small" Command="{Binding DeleteDecalCommand}" ToolTip.Tip="{Tr Studio.Decals.Delete.Tip}">
            <c:GlyphIcon Kind="Icon.Trash" IconSize="14" />
          </Button>
        </StackPanel>
        <ContentControl Content="{Binding SelectedDecal}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:DecalLayerViewModel">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="80,*,44" ColumnSpacing="6">
                  <TextBlock Text="{Tr Studio.Decals.Size}" Classes="caption" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="5" Maximum="300" Value="{Binding Size}" SmallChange="1" LargeChange="10" ToolTip.Tip="{Tr Studio.Decals.Size.Tip}" />
                  <TextBlock Grid.Column="2" Text="{Binding Size, StringFormat={}{0:0}}" Classes="caption mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="80,*,44" ColumnSpacing="6">
                  <TextBlock Text="{Tr Studio.Decals.Rotation}" Classes="caption" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding Rotation}" SmallChange="1" LargeChange="15" ToolTip.Tip="{Tr Studio.Decals.Rotation.Tip}" />
                  <TextBlock Grid.Column="2" Text="{Binding Rotation, StringFormat={}{0:0}°}" Classes="caption mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="80,*,44" ColumnSpacing="6">
                  <TextBlock Text="{Tr Studio.Decals.Opacity}" Classes="caption" VerticalAlignment="Center" />
                  <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Opacity}" SmallChange="1" LargeChange="10" ToolTip.Tip="{Tr Studio.Decals.Opacity.Tip}" />
                  <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:0} %}" Classes="caption mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <WrapPanel ItemSpacing="12">
                  <CheckBox IsChecked="{Binding Flip}" ToolTip.Tip="{Tr Studio.Decals.Flip.Tip}">
                    <TextBlock Text="{Tr Studio.Decals.Flip}" />
                  </CheckBox>
                  <CheckBox IsChecked="{Binding Mirror}" ToolTip.Tip="{Tr Studio.Decals.Mirror.Tip}">
                    <TextBlock Text="{Tr Studio.Decals.Mirror}" />
                  </CheckBox>
                </WrapPanel>
                <ComboBox ItemsSource="{x:Static vm:DecalLayerViewModel.Modes}" SelectedIndex="{Binding ModeIndex}" IsVisible="{Binding !IsSticker}"
                          HorizontalAlignment="Stretch" ToolTip.Tip="{Tr Studio.Decals.Mode.Tip}" />
                <ItemsControl ItemsSource="{Binding ShownRegions}" IsVisible="{Binding ShowsRegions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DecalColourItem">
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                        <ColorPicker Color="{Binding Colour}" IsAlphaEnabled="False" IsAlphaVisible="False" ToolTip.Tip="{Tr Studio.Decals.Region.Tip}" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="6" IsVisible="{Binding IsPalette}">
                  <TextBlock Text="{Tr Studio.Decals.Palette}" Classes="caption" />
                  <ItemsControl ItemsSource="{Binding Palette}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DecalColourItem">
                        <ColorPicker Color="{Binding Colour}" IsAlphaEnabled="False" IsAlphaVisible="False" ToolTip.Tip="{Tr Studio.Decals.Palette.Tip}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost small" Content="{Tr Studio.Decals.Shuffle}" ToolTip.Tip="{Tr Studio.Decals.Shuffle.Tip}"
                            Command="{Binding $parent[UserControl].((vm:ModulePageViewModel)DataContext).ShuffleDecalCommand}" />
                    <TextBlock Text="{Binding SeedText}" Classes="caption mono" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
