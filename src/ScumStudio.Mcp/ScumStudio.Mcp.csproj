<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ScumStudio.Mcp</RootNamespace>
    <AssemblyName>ScumStudio.Mcp</AssemblyName>
    <Description>Model Context Protocol server for ScumStudio: JSON-RPC tools over stdio and Streamable HTTP so an AI assistant can drive the studio (levels, actors, vehicles, weapons, projects, export).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScumStudio.Core\ScumStudio.Core.csproj" />
    <ProjectReference Include="..\ScumStudio.Assets\ScumStudio.Assets.csproj" />
    <ProjectReference Include="..\ScumStudio.Modding\ScumStudio.Modding.csproj" />
    <ProjectReference Include="..\ScumStudio.Level\ScumStudio.Level.csproj" />
    <ProjectReference Include="..\ScumStudio.Viewport\ScumStudio.Viewport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScumStudio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Skill\SKILL.md" LogicalName="ScumStudio.Mcp.Skill.SKILL.md" />
  </ItemGroup>

</Project>
