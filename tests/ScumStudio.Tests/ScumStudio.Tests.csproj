    <ProjectReference Include="..\..\src\ScumStudio.Rendering\ScumStudio.Rendering.csproj" />
    <ProjectReference Include="..\..\src\ScumStudio.Level\ScumStudio.Level.csproj" />
    <ProjectReference Include="..\..\src\ScumStudio.Modding\ScumStudio.Modding.csproj" />
    <ProjectReference Include="..\..\src\ScumStudio.Mcp\ScumStudio.Mcp.csproj" />
    <ProjectReference Include="..\..\src\ScumStudio.Viewport\ScumStudio.Viewport.csproj" />
    <ProjectReference Include="..\..\src\ScumStudio.App\ScumStudio.App.csproj" />
